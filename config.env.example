# Per-home tunables. Copy to config.env (gitignored) and edit.
KIDS_NIC_MAC=AA:BB:CC:DD:EE:FF       # MAC of the USB/second ethernet adapter
KIDS_IFACE=kids0                     # stable name we give it
KIDS_SUBNET=192.168.60.0/24
KIDS_GW_IP=192.168.60.1
UPLINK_IFACE=enp5s0                  # clawdia's real uplink to the main router
KIDS_SSID=kids-wifi                  # SSID you set on the Deco (AP mode)

# Household timezone. The daily budget resets at MIDNIGHT in this zone. The
# Postgres container runs UTC, so without this a NZ family's screen time would
# roll over at noon. Any IANA zone name works (Europe/London, America/Denver).
HEARTH_TZ=Pacific/Auckland
