#!/usr/bin/env bash
# Renders the DNS-layer enforcement into AdGuard Home: per-child category
# blocks become $client dnsrewrite rules that send a blocked category's
# domains to the portal IP, so the kid gets the "time's up / blocked" page
# instead of a dead connection. The nft layer (genkan off/on) is the coarse
# internet switch; this is the surgical per-category layer (gaming, video,
# social) that keeps Spotify and schoolwork up.
#
# Since 2026-09-02 it is also the layer that makes a whole-internet cut
# precise. The firewall allows the safety net and the reading list BY
# ADDRESS, and addresses are shared: Google's search front ends are the same
# machines as YouTube and Gmail, and a school site behind Cloudflare shares its
# two addresses with thousands of strangers. So while a device is cut, every
# name it asks for is answered with the portal's address, except the names on
# the allow list, which resolve normally. The address door stays open (the
# firewall cannot tell one name from another), but the name has to be typed
# into a hosts file to walk through it, which is bug-bounty territory in this
# house and not a thing a browser does by itself.
#
# AdGuard's filtering rules are a single global list, so we RENDER THE WHOLE
# LIST every time from the database (allow-list exceptions first, then the
# flag on-ramps, the category blocks, and last the per-address catch-alls).
# One API call, no drift. Idempotent, and cheap when nothing changed: the
# rendered list is hashed and a matching hash skips the write, which is what
# lets the meter call this every minute without rewriting AdGuard's config
# file every minute.
set -euo pipefail
: "${ADGUARD_URL:=http://127.0.0.1:8853}" "${ADGUARD_USER:=admin}" "${ADGUARD_PASS:?set ADGUARD_PASS}"
: "${PORTAL_IP:=192.168.60.1}"
# Connects as kids_agent, a role with no superuser, no DDL and no
# COPY ... TO PROGRAM. See config/db/grants.sql for what it may touch and why.
PG_CONTAINER="${PG_CONTAINER:-postgres}"
DB_NAME="${GENKAN_DB:-kids_network}"
DB_ROLE="${GENKAN_DB_ROLE:-kids_agent}"
psqll(){ docker exec -i "$PG_CONTAINER" psql -U "$DB_ROLE" -d "$DB_NAME" -tAc "$1"; }

render(){
  # The allow list first: these @@ exceptions win over every rule below.
  # scope='safety' (help lines, schoolwork) and scope='learn' (the reading
  # list) both survive a cut, so both are exempt from the catch-all.
  #
  # category='search' rows are matched EXACTLY (an anchored regex) rather
  # than with ||, which also matches subdomains: google.com is on the list so
  # a child can search, and ||google.com^ would quietly bring mail.google.com,
  # meet, chat and messages with it. Every other row keeps ||, because
  # wikipedia.org is meant to cover en.wikipedia.org.
  psqll "SELECT CASE WHEN category='search'
                  THEN '@@/^'||replace(domain,'.','\\.')||'\$/\$important'
                  ELSE '@@||'||domain||'^\$important' END
         FROM always_allow WHERE scope IN ('safety','learn') ORDER BY domain"
  psqll "SELECT CASE WHEN category='search'
                  THEN '@@/^'||replace(domain,'.','\\.')||'\$/\$dnsrewrite'
                  ELSE '@@||'||domain||'^\$dnsrewrite' END
         FROM always_allow WHERE scope IN ('safety','learn') ORDER BY domain"
  # Flagged on-ramps (Tor, darknet directories) -> the portal for EVERY child,
  # visiting children included, always, not only when a category is blocked. A plain blocklist entry gives
  # a dead connection; sending them to the portal means the kid gets the warm
  # "this one is blocked, come find me, you are not in trouble" page instead.
  # Self-harm patterns are deliberately excluded: those are a care signal and
  # must never hit a blocking page (the help lines stay reachable).
  psqll "
    SELECT '||'||f.pattern||'^\$client='||c.name||',dnsrewrite=${PORTAL_IP}'
    FROM flag_domains f CROSS JOIN children c
    WHERE f.category IN ('tor','darknet','drugs') AND c.kind IN ('child','guest-child') AND c.active
      AND f.pattern NOT LIKE '%.onion'
    ORDER BY c.name, f.pattern"

  # Every active per-child category block -> a $client dnsrewrite to the portal.
  # client tag is the child's name, matching the AdGuard client objects.
  psqll "
    SELECT '||'||cd.domain||'^\$client='||c.name||',dnsrewrite=${PORTAL_IP}'
    FROM category_state cs
    JOIN children c ON c.id=cs.child_id
    JOIN category_domains cd ON cd.category=cs.category
    WHERE cs.blocked AND cs.category IN ('gaming','video','social')
    ORDER BY c.name, cd.domain"

  # Every address the firewall is cutting right now -> every name goes to the
  # portal, except the allow list above. Keyed by ADDRESS, from the same view
  # the gateway reconciles @kids_block from (blocked_device_ips: a child's
  # internet off, a shared device off, the whole-house cut with its clock),
  # so the DNS layer and the packet layer cannot disagree about who is cut.
  # AdGuard's $client accepts an address directly; no client object needed.
  psqll "
    SELECT '/.*/\$client='||ip||',dnsrewrite=${PORTAL_IP}'
    FROM blocked_device_ips ORDER BY ip"
}

apply(){
  local rules; rules=$(render)
  # Skip the write when the list is what AdGuard already has. The hash file
  # alone is not enough: an AdGuard that was reseeded or restored has the old
  # hash on our side and nothing on its own, so the live rule count is checked
  # too, and any doubt means write. `apply --force` always writes.
  local state="${GENKAN_STATE_DIR:-/var/lib/genkan}/adguard-rules.sha256" want have live
  want=$(printf '%s\n' "$rules" | sha256sum | cut -c1-64)
  if [ "${1:-}" != "--force" ] && [ -r "$state" ]; then
    have=$(cut -c1-64 < "$state" 2>/dev/null)
    live=$(curl -s -u "$ADGUARD_USER:$ADGUARD_PASS" "$ADGUARD_URL/control/filtering/status" 2>/dev/null \
           | python3 -c 'import sys,json; print(len(json.load(sys.stdin).get("user_rules",[])))' 2>/dev/null || echo -1)
    if [ "$have" = "$want" ] && [ "$live" = "$(printf '%s\n' "$rules" | grep -c .)" ]; then
      echo "genkan-adguard: unchanged ($live rules)"; return 0
    fi
  fi
  # Build the JSON {"rules":[...]} safely with python.
  ADGUARD_URL="$ADGUARD_URL" ADGUARD_USER="$ADGUARD_USER" ADGUARD_PASS="$ADGUARD_PASS" \
  python3 - "$rules" <<'PYEOF'
import json,sys,os,urllib.request,base64
rules=[r for r in sys.argv[1].splitlines() if r.strip()]
body=json.dumps({"rules":rules}).encode()
u=os.environ["ADGUARD_URL"]+"/control/filtering/set_rules"
req=urllib.request.Request(u,data=body,method="POST")
auth=base64.b64encode(f'{os.environ["ADGUARD_USER"]}:{os.environ["ADGUARD_PASS"]}'.encode()).decode()
req.add_header("Authorization","Basic "+auth); req.add_header("Content-Type","application/json")
try:
    urllib.request.urlopen(req,timeout=8)
    print(f"genkan-adguard: applied {len(rules)} rules")
except Exception as e:
    print(f"genkan-adguard: FAILED to apply rules: {e}",file=sys.stderr); sys.exit(1)
PYEOF
  # Only after a successful write, so a failed one is retried next minute.
  { mkdir -p "$(dirname "$state")" && printf '%s\n' "$want" > "$state"; } 2>/dev/null || true
}

case "${1:-apply}" in
  apply)  apply "${2:-}";;
  render) render;;
  *) echo "usage: genkan-adguard [apply [--force]|render]"; exit 1;;
esac
