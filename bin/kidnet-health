#!/usr/bin/env bash
# genkan:summary=Compatibility shim: this tool is called genkan-health now.
#
# An older box upgrades with the kidnet-upgrade it already has installed, and
# that tool checks the household with $R/bin/kidnet-health from the freshly
# pulled tree. Without this file the check would fail and the upgrade would
# roll itself back. Remove after 2026.10.
exec "$(dirname "$(readlink -f "$0")")/genkan-health" "$@"
