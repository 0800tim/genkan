#!/usr/bin/env bash
# genkan:summary=Applies scheduled bedtimes every minute, and lifts them in the morning.
#
# Bedtimes used to be a parent typing `kidnet off kids` at nine and remembering
# to type `kidnet on kids` at seven. The remembering is the part that failed,
# and a child who wakes to a dead network because nothing lifted it has been
# punished by an oversight. The morning restore matters more than the bedtime.
#
#   genkan-schedule [apply]              apply the schedules (what the timer runs)
#   genkan-schedule show [kid]           what is set, what is in force, when it lifts
#   genkan-schedule set <kid> <days> <HH:MM> <HH:MM> [categories]
#   genkan-schedule clear <kid>          remove that child's schedules
#   genkan-schedule enable|disable <kid> keep the times, stop or start them firing
#   genkan-schedule extend <kid> <min>   tonight only, no schedule edited
#   genkan-schedule holiday <from> <to> [name]   no bedtimes between those dates
#   genkan-schedule holiday late <from> <to> <min> [name]   bedtime N minutes later
#   genkan-schedule holiday clear        end every override window now
#
# <days> is school | weekend | every | a list like 0,1,2,3,4 (0=Sunday).
#   school  = Sunday to Thursday nights, the nights before a school day
#   weekend = Friday and Saturday nights
# The days are the nights the window STARTS on, which is why Friday night and
# Tuesday night are different rows with different times.
#
# THE SET_BY RULE, which is the whole of the safety of this script:
# a schedule owns ONLY the blocks it applied, marked set_by='bedtime'. It never
# lifts a parent's block, an out-of-time block or an over-budget block. If a
# parent turns the internet back on during a bedtime, that release is recorded
# against the window and honoured until the next boundary, so this worker
# cannot stamp it back a minute later. Full table in DECISIONS.md.
#
# Nothing here touches nftables. The database is the desired state and the
# gateway container reconciles the firewall from it every 15 seconds, which is
# also why a reboot mid-bedtime comes back blocked: the block is a row, not a
# rule somebody has to remember to re-add.
set -euo pipefail

# Same least-privilege connection as bin/kidnet: kids_agent, no superuser, no
# DDL. config/db/grants.sql lists exactly what it may touch, and the schedule
# tables are on that list. The three overrides exist so test/schedule-test.sh
# can point the whole worker at a throwaway database instead of the household's.
PG_CONTAINER="${PG_CONTAINER:-postgres}"
DB_NAME="${GENKAN_DB:-kids_network}"
DB_ROLE="${GENKAN_DB_ROLE:-kids_agent}"
psqll(){ docker exec -i "$PG_CONTAINER" psql -U "$DB_ROLE" -d "$DB_NAME" -tAc "$1"; }
psqlq(){ docker exec -i "$PG_CONTAINER" psql -U "$DB_ROLE" -d "$DB_NAME" -q -v ON_ERROR_STOP=1 -c "$1" >/dev/null; }
# Same gates as bin/kidnet. Every value that reaches SQL passes one of these.
ck_name(){ [[ "$1" =~ ^[A-Za-z0-9_-]{1,32}$ ]] || { echo "genkan-schedule: bad name '$1'" >&2; exit 1; }; }
ck_int(){  [[ "$1" =~ ^[0-9]{1,4}$ ]] || { echo "genkan-schedule: bad number '$1'" >&2; exit 1; }; }
ck_date(){ [[ "$1" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || { echo "genkan-schedule: bad date '$1' (use YYYY-MM-DD)" >&2; exit 1; }; }
ck_text(){ [[ "$1" =~ ^[A-Za-z0-9_:+.,\ -]{0,60}$ ]] || { echo "genkan-schedule: bad text" >&2; exit 1; }; }
tid(){ ck_name "$1"; psqll "SELECT id FROM children WHERE lower(name)=lower('$1')"; }

# HH:MM to minutes from midnight. 24:00 is allowed as an end time and means
# midnight at the far end, which is not the same thing as 00:00 at the near end.
hhmm(){ local h m
  [[ "$1" =~ ^([0-9]{1,2}):([0-9]{2})$ ]] || { echo "genkan-schedule: '$1' is not a time like 21:00" >&2; exit 1; }
  h=$((10#${BASH_REMATCH[1]})); m=$((10#${BASH_REMATCH[2]}))
  [ "$h" -le 24 ] && [ "$m" -le 59 ] || { echo "genkan-schedule: '$1' is not a real time" >&2; exit 1; }
  echo $((h*60+m)); }

daylist(){ case "$1" in
  school)  echo "0,1,2,3,4";;
  weekend) echo "5,6";;
  every|all|daily) echo "0,1,2,3,4,5,6";;
  *) [[ "$1" =~ ^[0-6](,[0-6]){0,6}$ ]] || { echo "genkan-schedule: '$1' is not school, weekend, every or a list like 0,1,2,3,4" >&2; exit 1; }
     echo "$1";; esac; }

catlist(){ local c out=""
  for c in $(echo "${1:-internet}" | tr ',' ' '); do
    case "$c" in internet|gaming|video|social|all) ;;
      *) echo "genkan-schedule: '$c' is not something a bedtime can switch off" >&2; exit 1;; esac
    out="$out,'$c'"; done
  echo "ARRAY[${out#,}]::text[]"; }

# The AdGuard side. gaming/video/social bedtimes are enforced at the DNS layer,
# so a change to one has to be pushed. Best effort and never fatal: the
# database is still the truth and the reconcilers catch up.
adguard_sync(){ [ -n "${ADGUARD_PASS:-}" ] || return 0
  local d; d="$(dirname "$0")/genkan-adguard"
  [ -x "$d" ] && "$d" apply >/dev/null 2>&1 || true; }

# ---------------------------------------------------------------------------
# apply: the three statements the timer runs, in this order and only this order
# ---------------------------------------------------------------------------
# 1. RELEASES. A parent turned something back on during a window we had already
#    asserted. Remember it against that window so step 2 leaves it alone. This
#    MUST run before the assert, or the override lives for one minute.
# 2. ASSERT. Block what the window says to block, but never overwrite a block
#    somebody else owns, and never touch a window a parent has released.
# 3. LIFT. Anything still blocked with set_by='bedtime' that no window in force
#    calls for. Driven off category_state rather than off the schedules table on
#    purpose: a schedule that was deleted, disabled or edited mid-window would
#    otherwise leave a child blocked with nothing left to lift it.
# A database that has not been given schema-schedule.sql yet is a real state:
# an existing household that pulled the repo but has not deployed. Say so once,
# in words, and exit clean. A timer that fails every minute with a psql trace
# teaches a household to ignore its own journal.
have_tables(){
  [ "$(psqll "SELECT to_regclass('public.schedule_state') IS NOT NULL" 2>/dev/null)" = t ]; }
need_tables(){ have_tables && return 0
  echo "genkan-schedule: this database has no bedtime tables yet, so there is nothing to apply." >&2
  echo "  Load them with: config/db/load.sh $DB_NAME   (or re-run deploy.sh)" >&2
  return 1; }

apply(){
  local rel ass lift
  need_tables || return 0

  rel=$(psqll "
    WITH live AS (
      SELECT w.child_id, w.schedule_id, w.window_key, unnest(w.categories) AS category
        FROM schedule_windows(now()) w
       WHERE w.in_window AND w.action='block'
    ),
    r AS (
    INSERT INTO schedule_state
      (child_id, schedule_id, category, window_key, asserted_ts, released_key, released_ts, last_run)
    SELECT l.child_id, l.schedule_id, l.category, st.window_key, st.asserted_ts,
           l.window_key, now(), now()
      FROM live l
      JOIN schedule_state st
        ON st.child_id=l.child_id AND st.schedule_id=l.schedule_id AND st.category=l.category
      LEFT JOIN category_state cs
        ON cs.child_id=l.child_id AND cs.category=l.category
     WHERE st.window_key = l.window_key
       AND st.asserted_ts IS NOT NULL
       AND st.released_key IS DISTINCT FROM l.window_key
       AND COALESCE(cs.blocked,false) = false
    ON CONFLICT (child_id, schedule_id, category) DO UPDATE
       SET released_key=EXCLUDED.released_key, released_ts=now(), last_run=now()
    RETURNING 1
    )
    SELECT count(*) FROM r")

  # The assert, and the audit row that goes with it, in one statement so an
  # action can never be applied without being recorded.
  ass=$(psqll "
    WITH live AS (
      SELECT w.child_id, w.schedule_id, w.window_key, w.name, unnest(w.categories) AS category
        FROM schedule_windows(now()) w
       WHERE w.in_window AND w.action='block'
    ),
    todo AS (
      SELECT l.*
        FROM live l
        LEFT JOIN schedule_state st
          ON st.child_id=l.child_id AND st.schedule_id=l.schedule_id AND st.category=l.category
        LEFT JOIN category_state cs
          ON cs.child_id=l.child_id AND cs.category=l.category
       WHERE st.released_key IS DISTINCT FROM l.window_key
         AND COALESCE(cs.blocked,false) = false
    ),
    ins AS (
      INSERT INTO category_state(child_id, category, blocked, since, set_by)
      SELECT child_id, category, true, now(), 'bedtime' FROM todo
      ON CONFLICT (child_id, category) DO UPDATE
         SET blocked=true, since=now(), set_by='bedtime'
      RETURNING child_id, category
    ),
    aud AS (
      INSERT INTO block_events(target_type, target_ref, action, source, actor)
      SELECT 'child', c.name||':'||i.category, 'off', 'schedule', 'genkan-schedule'
        FROM ins i JOIN children c ON c.id=i.child_id
      RETURNING 1
    )
    SELECT count(*) FROM aud")

  # Taking responsibility for the window, whether or not we changed anything.
  # Recording it even when the category was ALREADY blocked by a parent is
  # deliberate: it is what lets a parent turn it back on later tonight and have
  # that stick, instead of the worker treating their 'on' as a fresh window it
  # has never seen and blocking again.
  psqlq "
    WITH live AS (
      SELECT w.child_id, w.schedule_id, w.window_key, unnest(w.categories) AS category
        FROM schedule_windows(now()) w
       WHERE w.in_window AND w.action='block'
    )
    INSERT INTO schedule_state
      (child_id, schedule_id, category, window_key, asserted_ts, last_run)
    SELECT child_id, schedule_id, category, window_key, now(), now() FROM live
    ON CONFLICT (child_id, schedule_id, category) DO UPDATE
       SET window_key = EXCLUDED.window_key,
           asserted_ts = CASE WHEN schedule_state.window_key IS DISTINCT FROM EXCLUDED.window_key
                              THEN now() ELSE schedule_state.asserted_ts END,
           last_run = now()"

  lift=$(psqll "
    WITH gone AS (
      UPDATE category_state cs
         SET blocked=false, since=now(), set_by='schedule-lifted'
       WHERE cs.blocked AND cs.set_by='bedtime'
         AND NOT EXISTS (
           SELECT 1 FROM schedule_windows(now()) w
            WHERE w.in_window AND w.action='block'
              AND w.child_id = cs.child_id
              AND cs.category = ANY (w.categories))
      RETURNING cs.child_id, cs.category
    ),
    aud AS (
      INSERT INTO block_events(target_type, target_ref, action, source, actor)
      SELECT 'child', c.name||':'||g.category, 'on', 'schedule', 'genkan-schedule'
        FROM gone g JOIN children c ON c.id=g.child_id
      RETURNING 1
    )
    SELECT count(*) FROM aud")

  # Clear the memory of windows that are over, so the table does not grow a row
  # per child per night forever. Only rows we have not touched in a month.
  psqlq "DELETE FROM schedule_state WHERE last_run < now() - interval '30 days'"

  # Quiet unless something changed, because this runs sixty times an hour and a
  # journal full of "nothing happened" is a journal nobody reads.
  if [ "${ass:-0}" != 0 ] || [ "${lift:-0}" != 0 ]; then
    echo "genkan-schedule: ${ass:-0} blocked, ${lift:-0} lifted"
    adguard_sync
  fi
  # A release is worth one line the moment it happens, and silence afterwards.
  [ "${rel:-0}" = 0 ] || echo "genkan-schedule: ${rel} left alone, a parent had turned them back on"
}

# ---------------------------------------------------------------------------
show(){
  local where="" nwhere=""
  need_tables || return 0
  # Two different shapes: the schedules query joins children, the tonight view
  # already carries the name as `child`. One $where for both put c.name into a
  # query with no c in it, and every `show <kid>` printed an error where the
  # answer should have been.
  if [ -n "${1:-}" ]; then ck_name "$1"
    where="AND lower(c.name)=lower('$1')"; nwhere="AND lower(child)=lower('$1')"; fi
  echo "Bedtimes"
  psqll "
    SELECT '  '||c.name||'  '||s.name||'  '
           ||to_char((date '2000-01-02' + make_interval(mins=>s.start_min)),'HH24:MI')||' to '
           ||to_char((date '2000-01-02' + make_interval(mins=>s.end_min)),'HH24:MI')
           ||'  ['||array_to_string(s.days,',')||']  '||array_to_string(s.categories,'+')
           ||CASE WHEN s.enabled THEN '' ELSE '   (disabled)' END
      FROM schedules s JOIN children c ON c.id=s.child_id
     WHERE true $where ORDER BY c.name, s.start_min" || true
  echo "Tonight"
  psqll "
    SELECT '  '||child||': '||
           CASE WHEN in_window
                THEN 'off now, back at '||to_char(ends_at,'HH24:MI')
                ELSE 'off at '||to_char(starts_at,'HH24:MI')||', back at '||to_char(ends_at,'HH24:MI') END
           ||CASE WHEN extended THEN '  (extended tonight)' ELSE '' END
           ||COALESCE('  ['||override||']','')
      FROM schedule_next WHERE true $nwhere ORDER BY child" || true
  echo "Override windows"
  psqll "
    SELECT '  '||COALESCE(c.name,'everybody')||'  '||o.name||'  '||o.starts||' to '||o.ends
           ||'  '||o.mode||CASE WHEN o.mode='late' THEN ' +'||o.shift_min||' min' ELSE '' END
      FROM schedule_overrides o LEFT JOIN children c ON c.id=o.child_id
     WHERE o.enabled AND o.ends >= CURRENT_DATE ORDER BY o.starts" || true
}

case "${1:-apply}" in
  apply|"") apply;;
  show) show "${2:-}";;
  set)
    kid="${2:?kid}"; days=$(daylist "${3:?days}"); s=$(hhmm "${4:?start HH:MM}"); e=$(hhmm "${5:?end HH:MM}")
    cats=$(catlist "${6:-internet}")
    cid=$(tid "$kid"); [ -n "$cid" ] || { echo "genkan-schedule: nobody called '$kid'"; exit 1; }
    label="$( [ "${3}" = weekend ] && echo "weekend bedtime" || { [ "${3}" = school ] && echo "school-night bedtime" || echo "bedtime"; } )"
    # One schedule per child per set of days: setting a school-night bedtime
    # twice must change it, not stack a second one on top of it.
    psqlq "DELETE FROM schedules WHERE child_id=$cid AND days = ARRAY[$days]::int[]"
    psqlq "INSERT INTO schedules(child_id,name,days,start_min,end_min,action,enabled,categories,set_by,updated_ts)
           VALUES($cid,'$label',ARRAY[$days]::int[],$s,$e,'block',true,$cats,'cli',now())"
    # Straight away, not up to a minute from now. A parent setting a bedtime at
    # half past nine means it from half past nine.
    apply
    echo "genkan-schedule: $kid off at ${4} back at ${5} on days [$days]"
    show "$kid";;
  clear)
    cid=$(tid "${2:?kid}"); [ -n "$cid" ] || { echo "genkan-schedule: nobody called '$2'"; exit 1; }
    psqlq "DELETE FROM schedules WHERE child_id=$cid"
    # Deleting the schedule cascades its state away, so the next apply lifts
    # anything it was holding. Run it now rather than leaving a child blocked
    # for up to a minute by a bedtime that no longer exists.
    apply
    echo "genkan-schedule: no bedtimes for $2 any more";;
  enable|disable)
    cid=$(tid "${2:?kid}"); [ -n "$cid" ] || { echo "genkan-schedule: nobody called '$2'"; exit 1; }
    on=$( [ "$1" = enable ] && echo true || echo false )
    psqlq "UPDATE schedules SET enabled=$on, updated_ts=now() WHERE child_id=$cid"
    apply; echo "genkan-schedule: $2's bedtimes are now $1d";;
  extend)
    cid=$(tid "${2:?kid}"); ck_int "${3:?minutes}"
    [ -n "$cid" ] || { echo "genkan-schedule: nobody called '$2'"; exit 1; }
    [ "${3}" -le 720 ] || { echo "genkan-schedule: an extension is for tonight, not twelve hours"; exit 1; }
    # From the later of now and tonight's bedtime, so granting twenty minutes
    # at half past eight gives twenty minutes past nine, not twenty past eight.
    u=$(psqll "
      WITH n AS (SELECT starts_at, ends_at FROM schedule_next WHERE child_id=$cid)
      INSERT INTO schedule_extensions(child_id, until_ts, minutes, reason, granted_by)
      SELECT $cid, GREATEST(now(), n.starts_at) + make_interval(mins=>${3}), ${3}, 'tonight', 'cli'
        FROM n WHERE GREATEST(now(), n.starts_at) + make_interval(mins=>${3}) < n.ends_at
      RETURNING to_char(until_ts,'HH24:MI')" | grep -E '^[0-9]{2}:[0-9]{2}$' || true)
    # psql prints the command tag when a RETURNING clause matched no rows, so
    # "INSERT 0 0" is what a refused extension looks like. Filtering for an
    # actual time is what tells the two apart; without it the script cheerfully
    # told a parent their child could stay on until INSERT 0 0.
    if [ -z "$u" ]; then
      # Either there is no bedtime tonight at all, or the extension is longer
      # than the bedtime lasts, which would mean granting the whole night. Say
      # which, because they call for different answers.
      if [ -z "$(psqll "SELECT 1 FROM schedule_next WHERE child_id=$cid")" ]; then
        echo "genkan-schedule: $2 has no bedtime tonight to extend"
      else
        echo "genkan-schedule: ${3} minutes is longer than $2's bedtime lasts. To drop tonight entirely, use: genkan-schedule holiday $(date +%F) $(date +%F)"
      fi
      exit 1
    fi
    apply
    echo "genkan-schedule: $2 can stay on until $u tonight. Tomorrow is unchanged.";;
  holiday) case "${2:-}" in
      clear) psqlq "UPDATE schedule_overrides SET enabled=false WHERE enabled"
             apply; echo "genkan-schedule: override windows ended, normal bedtimes from now";;
      late)  ck_date "${3:?from}"; ck_date "${4:?to}"; ck_int "${5:?minutes}"; ck_text "${6:-later nights}"
             psqlq "INSERT INTO schedule_overrides(child_id,name,starts,ends,mode,shift_min,set_by)
                    VALUES(NULL,'${6:-later nights}','$3','$4','late',${5},'cli')"
             apply; echo "genkan-schedule: bedtimes start ${5} min later from $3 to $4";;
      "")    echo "usage: genkan-schedule holiday <from> <to> [name] | holiday late <from> <to> <min> [name] | holiday clear"; exit 1;;
      *)     ck_date "${2}"; ck_date "${3:?to}"; ck_text "${4:-school holidays}"
             psqlq "INSERT INTO schedule_overrides(child_id,name,starts,ends,mode,set_by)
                    VALUES(NULL,'${4:-school holidays}','$2','$3','off','cli')"
             apply; echo "genkan-schedule: no bedtimes from $2 to $3";;
    esac;;
  *) sed -n '3,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//';;
esac
