#!/usr/bin/env bash
# genkan:summary=Install, list and remove community learning packages written by other people.
#
# A learning package is one JSON file: a quiz bank, plus who wrote it, what
# licence it carries, who it is for, and optionally a short piece to read
# first. It is the same format a bank has always used with one optional block
# added, so a bank you have already written is a package once you add four
# lines saying who wrote it. The format is docs/CONTRIBUTING-CONTENT.md and
# portal/quizzes/community/README.md.
#
#   genkan-pack list                     what is installed, and what is on the shelf
#   genkan-pack validate <file>...       check a package without installing it
#   genkan-pack install <file> [--force] validate, then install it for the kids
#   genkan-pack remove <id> [--off]      remove it, or just take it off the list
#
# WHY THIS IS NOT `genkan-quiz install`. That command copies a bank file into
# portal/quizzes, which is tracked in git: a `git pull` would delete a family's
# installed content, and a repo update would silently overwrite it. A package
# goes into the DATABASE instead, exactly like a bank a parent writes on the
# dashboard (config/db/schema-packages.sql). Updating Genkan cannot touch it,
# and removing it is one row.
#
# NOTHING HERE TOUCHES THE NETWORK. There is no package registry, no download,
# no update check and no telemetry. A package arrives as a file, because
# somebody handed it to you or you pulled the repo. Genkan does not phone home
# and this script is not the exception.
#
# The portal notices an installed package within about half a minute, because
# it polls the database shelf. Nothing needs restarting.
set -euo pipefail

SELF="$(readlink -f "$0")"
REPO="${GENKAN_REPO:-$(cd "$(dirname "$SELF")/.." && pwd)}"
QUIZ_DIR="${QUIZ_DIR:-$REPO/portal/quizzes}"
SHELF="${PACK_SHELF:-$QUIZ_DIR/community}"
VALIDATOR="${PACK_VALIDATOR:-$REPO/tools/validate-package.mjs}"
# Connects as kids_agent, the least-privilege role: no superuser, no DDL, no
# COPY ... TO PROGRAM. It cannot write the quiz tables directly either. The two
# SECURITY DEFINER functions in config/db/schema-packages.sql are the only way
# it can install or remove, which is deliberate: one narrow, audited operation
# instead of open write access to every bank in the house.
PG_CONTAINER="${PG_CONTAINER:-postgres}"
DB_NAME="${GENKAN_DB:-kids_network}"
DB_ROLE="${GENKAN_DB_ROLE:-kids_agent}"

psqll(){ docker exec -i "$PG_CONTAINER" psql -U "$DB_ROLE" -d "$DB_NAME" -tAF$'\t' -c "$1"; }
psqlf(){ docker exec -i "$PG_CONTAINER" psql -U "$DB_ROLE" -d "$DB_NAME" -tA -v ON_ERROR_STOP=1; }
ck_id(){ [[ "$1" =~ ^[a-z0-9-]{1,48}$ ]] || { echo "genkan-pack: bad package id '$1' (lowercase, digits and hyphens)" >&2; exit 1; }; }
need(){ command -v "$1" >/dev/null || { echo "genkan-pack: needs $1" >&2; exit 1; }; }
need_validator(){ [ -f "$VALIDATOR" ] || { echo "genkan-pack: no validator at $VALIDATOR (set GENKAN_REPO)" >&2; exit 1; }; }
have_table(){ [ "$(psqll "SELECT to_regclass('public.quiz_packages') IS NOT NULL" 2>/dev/null | head -1)" = "t" ]; }
need_table(){ have_table || { echo "genkan-pack: the quiz_packages table is not there yet." >&2
    echo "  Load it with: config/db/load.sh $DB_NAME $PG_CONTAINER   (or just schema-packages.sql)" >&2; exit 1; }; }

# ---------------------------------------------------------------------------
# validate
# ---------------------------------------------------------------------------
# Strict: a package a household installs has to say who wrote it and under what
# licence. To check a plain bank with no manifest, run the validator directly:
#   node tools/validate-package.mjs <file>
cmd_validate(){ need_validator; need node
  [ $# -gt 0 ] || { echo "usage: genkan-pack validate <file.json>..." >&2; exit 1; }
  for f in "$@"; do [ -f "$f" ] || { echo "genkan-pack: no such file '$f'" >&2; exit 1; }; done
  node "$VALIDATOR" --strict "$@"
}

# ---------------------------------------------------------------------------
# install
# ---------------------------------------------------------------------------
cmd_install(){ need_validator; need node; need docker; need python3; need_table
  local force=0 src="" a
  for a in "$@"; do case "$a" in
    --force) force=1;;
    -*) echo "genkan-pack: unknown flag $a" >&2; exit 1;;
    *) src="$a";;
  esac; done
  [ -n "$src" ] || { echo "usage: genkan-pack install <file.json> [--force]" >&2; exit 1; }
  [ -f "$src" ] || { echo "genkan-pack: no such file '$src'" >&2; exit 1; }

  local base id; base="$(basename "$src")"
  case "$base" in *.json) ;; *) echo "genkan-pack: a package file must be named <id>.json" >&2; exit 1;; esac
  id="${base%.json}"; ck_id "$id"

  # 1. It has to pass, every rule, before anything reaches the database. A
  #    package is a stranger's text on a page a child reads.
  echo "checking $src"
  node "$VALIDATOR" --strict "$src" || {
    echo "genkan-pack: not installed. Nothing above is a judgement on the content:" >&2
    echo "  docs/CONTRIBUTING-CONTENT.md explains every rule and how to fix it." >&2; exit 1; }

  # 2. A file bank of the same id would win on the portal, so the package would
  #    install and then be invisible. Say so rather than doing it.
  if [ -f "$QUIZ_DIR/$id.json" ]; then
    echo "genkan-pack: portal/quizzes/$id.json already exists, and a file bank beats a" >&2
    echo "  database one, so this package would install and never be seen." >&2
    echo "  Rename the package's id, or move the file bank out of the way first." >&2
    exit 1
  fi

  # 3. Already installed? Re-installing is the normal way to take an update,
  #    but it replaces every question, so it is not something to do by accident.
  local installed; installed="$(psqll "SELECT author FROM quiz_packages WHERE bank_id='$id'" | head -1)"
  if [ -n "$installed" ] && [ "$force" != 1 ]; then
    echo "genkan-pack: '$id' is already installed (by $installed)." >&2
    echo "  Use --force to replace it with this file. Every question is replaced;" >&2
    echo "  the kids' past rounds and the minutes they earned are untouched." >&2
    exit 1
  fi

  local sha; sha="$(sha256sum "$src" | cut -d' ' -f1)"
  # 4. The whole package goes in as ONE jsonb value, so there is one string to
  #    quote instead of hundreds, and the install is a single transaction that
  #    either lands or does not. The SQL is fed on stdin rather than as an
  #    argument, because a package is bigger than a comfortable command line.
  local out
  out=$(python3 - "$src" "$base" "${USER:-unknown}" "$sha" <<'PY' | psqlf
import json, sys
src, base, who, sha = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
pkg = json.load(open(src, encoding="utf-8"))
# ensure_ascii keeps the payload to one line of plain ASCII, so the only thing
# that needs quoting for SQL is the single quote. standard_conforming_strings
# is on by default, so a backslash in the JSON stays a backslash.
def lit(s): return "'" + s.replace("'", "''") + "'"
print("SELECT install_quiz_package(%s::jsonb, %s, %s, %s);"
      % (lit(json.dumps(pkg, ensure_ascii=True, separators=(",", ":"))),
         lit(base), lit(who), lit(sha)))
PY
  ) || { echo "genkan-pack: the database refused it. Nothing was installed." >&2; exit 1; }

  echo "installed: $out"
  echo "The kids' portal picks it up within about half a minute. Nothing to restart."
  echo "Take a round yourself before they do. It is their time you are spending."
}

# ---------------------------------------------------------------------------
# remove
# ---------------------------------------------------------------------------
cmd_remove(){ need docker; need_table
  local id="" keep=false a
  for a in "$@"; do case "$a" in
    --off) keep=true;;
    -*) echo "genkan-pack: unknown flag $a" >&2; exit 1;;
    *) id="$a";;
  esac; done
  [ -n "$id" ] || { echo "usage: genkan-pack remove <id> [--off]" >&2; exit 1; }
  ck_id "$id"
  local out
  # remove_quiz_package refuses any bank that did not arrive as a package, so
  # this can never delete a bank a parent wrote on the dashboard.
  out=$(psqll "SELECT remove_quiz_package('$id', $keep)" 2>&1) || {
    echo "$out" | sed 's/^/  /' >&2
    echo "genkan-pack: nothing removed. 'genkan-pack list' shows what is installed." >&2; exit 1; }
  echo "$out"
}

# ---------------------------------------------------------------------------
# list
# ---------------------------------------------------------------------------
# One line per installed package, then the shelf that ships with the repo, so a
# parent can see at a glance what they have and what they could have.
cmd_list(){ need docker
  echo "== Installed on this box"
  if have_table; then
    local rows
    rows="$(psqll "SELECT rpad(bank_id,26) || rpad(coalesce(author,'?'),22) || rpad(licence,14)
                          || lpad(questions::text,4) || ' q  '
                          || CASE WHEN live THEN 'live   ' ELSE 'off    ' END
                          || CASE WHEN has_read_first THEN 'read-first  ' ELSE '            ' END
                          || to_char(installed_ts,'YYYY-MM-DD')
                     FROM quiz_package_summary ORDER BY installed_ts DESC" 2>/dev/null || true)"
    if [ -n "$rows" ]; then
      printf '  %-26s%-22s%-14s%5s  %-7s%-12s%s\n' ID AUTHOR LICENCE Q STATE EXTRAS INSTALLED
      printf '%s\n' "$rows" | sed 's/^/  /'
    else
      echo "  nothing installed yet"
    fi
  else
    echo "  the quiz_packages table is not loaded, so nothing can be installed yet"
    echo "  (config/db/load.sh $DB_NAME $PG_CONTAINER)"
  fi

  echo
  echo "== On the shelf in $SHELF"
  local n=0 f id title author state
  if [ -d "$SHELF" ]; then
    for f in "$SHELF"/*.json; do
      [ -e "$f" ] || continue
      n=$((n+1))
      IFS=$'\t' read -r id title author < <(python3 - "$f" <<'PY'
import json, sys, os
try: b = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception: print("\t".join([os.path.basename(sys.argv[1]), "UNREADABLE", ""])); raise SystemExit(0)
m = b.get("package") or {}
print("\t".join([str(b.get("id", "?")), str(b.get("title", "?"))[:30], str(m.get("author", "unattributed"))[:20]]))
PY
      )
      state="not installed"
      if have_table && [ -n "$(psqll "SELECT 1 FROM quiz_packages WHERE bank_id='$id'" 2>/dev/null | head -1)" ]; then
        state="installed"
      fi
      printf '  %-26s%-32s%-22s%s\n' "$id" "$title" "$author" "$state"
    done
  fi
  [ "$n" -gt 0 ] || echo "  nothing on the shelf"
  echo
  echo "  Install one with: genkan-pack install $SHELF/<id>.json"
  echo "  Read it first. Nobody at Genkan has checked a stranger's answers for you,"
  echo "  and a wrong answer takes minutes off a child for being right."
}

case "${1:-}" in
  list)     shift; cmd_list "$@";;
  validate) shift; cmd_validate "$@";;
  install)  shift; cmd_install "$@";;
  remove)   shift; cmd_remove "$@";;
  ""|-h|--help|help) awk 'NR>3 && /^#/ { sub(/^# ?/, ""); print; next } NR>3 { exit }' "$SELF";;
  *) echo "genkan-pack: unknown command '$1'. Try: genkan-pack help" >&2; exit 1;;
esac
