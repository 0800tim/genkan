#!/usr/bin/env bash
# hearth:summary=Discover devices from AdGuard's DHCP leases into the devices table.
#
# When a phone/laptop joins the kids' wifi it gets a DHCP lease from AdGuard.
# This pulls those leases (MAC, hostname, IP) and upserts a devices row per MAC,
# owned by nobody until the parent assigns it. Refreshes last_seen so the
# dashboard shows who is online. Runs on a short timer. Logs devices, not people.
set -euo pipefail
: "${ADGUARD_URL:=http://127.0.0.1:8853}" "${ADGUARD_USER:=admin}" "${ADGUARD_PASS:?set ADGUARD_PASS}"
# Connects as kids_agent, a role with no superuser, no DDL and no
# COPY ... TO PROGRAM. See config/db/grants.sql for what it may touch and why.
PG_CONTAINER="${PG_CONTAINER:-postgres}"
DB_NAME="${HEARTH_DB:-kids_network}"
DB_ROLE="${HEARTH_DB_ROLE:-kids_agent}"
DB=(docker exec -i "$PG_CONTAINER" psql -U "$DB_ROLE" -d "$DB_NAME")

TSV=$(ADGUARD_URL="$ADGUARD_URL" ADGUARD_USER="$ADGUARD_USER" ADGUARD_PASS="$ADGUARD_PASS" python3 <<'PY'
import os,json,urllib.request,base64,sys,csv
url=os.environ["ADGUARD_URL"]
auth=base64.b64encode(f'{os.environ["ADGUARD_USER"]}:{os.environ["ADGUARD_PASS"]}'.encode()).decode()
r=urllib.request.Request(url+"/control/dhcp/status"); r.add_header("Authorization","Basic "+auth)
try: d=json.load(urllib.request.urlopen(r,timeout=8))
except Exception as e: print(f"devicescan: cannot read DHCP status: {e}",file=sys.stderr); sys.exit(0)
w=csv.writer(sys.stdout,delimiter="\t")
for L in (d.get("leases") or [])+(d.get("static_leases") or []):
    mac=(L.get("mac") or "").lower(); ip=L.get("ip") or ""; host=L.get("hostname") or ""
    if mac and ip: w.writerow([mac,ip,host])
PY
)
[ -z "$TSV" ] && { echo "kidnet-devicescan: no DHCP leases (server not serving yet?)"; exit 0; }
printf '%s\n' "$TSV" | "${DB[@]}" -qc "
CREATE TEMP TABLE _lease(mac text, ip inet, hostname text);
COPY _lease FROM STDIN WITH (FORMAT text);
-- New MAC -> create an unassigned device row. Known MAC -> refresh seen +
-- hostname. DISTINCT ON is load bearing: a device can hold more than one lease
-- (a renewal on a new address, or a static plus a dynamic entry), and Postgres
-- cannot apply ON CONFLICT to the same row twice within one statement.
--
-- last_seen is refreshed from the LEASE list, and a lease outlives the device
-- that holds it, so last_seen alone can never mean "here right now". Presence
-- is decided separately, from the neighbour table, further down.
INSERT INTO devices(mac, hostname, kind, is_active, first_seen, last_seen)
SELECT DISTINCT ON (mac) mac::macaddr, NULLIF(hostname,''), 'unknown', true, now(), now()
  FROM _lease ORDER BY mac, hostname DESC NULLS LAST
ON CONFLICT (mac) DO UPDATE SET last_seen=now(),
  hostname=COALESCE(NULLIF(EXCLUDED.hostname,''), devices.hostname), is_active=true;
-- Refresh the live lease table too (drives 'kidnet leases').
INSERT INTO dhcp_leases(ip, mac, hostname, active, starts)
SELECT DISTINCT ON (ip) ip, mac::macaddr, NULLIF(hostname,''), true, now()
  FROM _lease ORDER BY ip
ON CONFLICT (ip) DO UPDATE SET mac=EXCLUDED.mac, hostname=EXCLUDED.hostname, active=true;
-- A lease that has moved must drag the reservation with it. Everything that
-- enforces anything (the block set, the meter, the AdGuard tier) keys on
-- reserved_ip, so a stale one means we would block, meter and filter an
-- address the device is no longer using: the controls would appear to work
-- and quietly do nothing.
UPDATE devices d SET reserved_ip = l.ip
  FROM _lease l
 WHERE d.mac = l.mac::macaddr
   AND (d.reserved_ip IS NULL OR d.reserved_ip IS DISTINCT FROM l.ip);
-- Stale leases for addresses a device no longer holds.
UPDATE dhcp_leases SET active=false
 WHERE active AND ip NOT IN (SELECT ip FROM _lease);"
# Presence, from the gateway's neighbour table rather than the lease list. A
# device in that table answered ARP recently, so it is genuinely on the wire.
# A lease proves only that we gave it an address once.
GW="${GW_CONTAINER:-hearth-gw}"
PRESENT=$(docker exec "$GW" ip neigh show dev kids0 2>/dev/null \
  | grep -iE 'REACHABLE|STALE|DELAY|PROBE' | awk '{print $1}' | grep -E '^[0-9]' | paste -sd, || true)
# PRESENT is interpolated into SQL, so it must be nothing but addresses and
# commas. `ip neigh` has never produced anything else, and this makes it so.
case "${PRESENT:-}" in *[!0-9.,]*) PRESENT="";; esac
if [ -n "${PRESENT:-}" ]; then
  "${DB[@]}" -qc "UPDATE devices SET present_at = now()
                   WHERE host(reserved_ip) = ANY (string_to_array('$PRESENT', ','))" 2>/dev/null || true
fi

# Auto-classify anything new (personal / iot / infra).
d="$(dirname "$0")/kidnet-classify"; [ -x "$d" ] && "$d" >/dev/null 2>&1 || true
N=$(printf '%s\n' "$TSV" | grep -c . || true)
echo "kidnet-devicescan: saw $N device(s) on the network"
