#!/usr/bin/env bash
# genkan:summary=Raise alerts when a device reaches a flagged domain.
#
# Scans newly ingested dns_log rows against flag_domains and writes an alert
# per match. This is the "tell me about the genuinely concerning stuff" layer,
# separate from ordinary blocking: Tor/darknet signals, self-harm (a CARE
# alert, never disciplinary), VPN-bypass attempts.
#
# The ethos: an alert is a prompt to have a conversation, not a verdict on a
# kid. The dashboard and the family agent surface these; what happens next is
# a talk, not an automatic punishment.
set -uo pipefail
# Connects as kids_agent, a role with no superuser, no DDL and no
# COPY ... TO PROGRAM. See config/db/grants.sql for what it may touch and why.
PG_CONTAINER="${PG_CONTAINER:-postgres}"
DB_NAME="${GENKAN_DB:-kids_network}"
DB_ROLE="${GENKAN_DB_ROLE:-kids_agent}"
psqll(){ docker exec -i "$PG_CONTAINER" psql -U "$DB_ROLE" -d "$DB_NAME" -tAc "$1"; }
LOOKBACK="${ALERT_LOOKBACK:-15 minutes}"
# It is an interval, and it is interpolated into SQL, so it has to look like
# one. Operator-supplied rather than kid-supplied, but the whole point of the
# gates is that "who supplies it" is not the thing keeping us safe.
[[ "$LOOKBACK" =~ ^[0-9]{1,4}\ (second|minute|hour|day)s?$ ]] || {
  echo "genkan-alerts: ALERT_LOOKBACK must be like '15 minutes'" >&2; exit 1; }

# One alert per (child, pattern) per day, so a busy device does not spam.
rows=$(psqll "
WITH hits AS (
  -- Most SPECIFIC pattern wins per child+domain: bridges.torproject.org is a
  -- stronger signal (deliberate block evasion) than plain torproject.org, and
  -- we want one alert describing the worst thing seen, not one per pattern.
  SELECT DISTINCT ON (d.child_id, l.domain)
         d.child_id, d.id AS device_id, f.pattern, f.category, f.severity, f.note, l.domain, l.ts
  FROM dns_log l
  JOIN devices d  ON d.id = l.device_id
  JOIN flag_domains f ON l.domain ILIKE '%' || f.pattern
  WHERE l.ts > now() - interval '$LOOKBACK'
  ORDER BY d.child_id, l.domain,
           (f.severity='urgent') DESC, length(f.pattern) DESC, l.ts DESC
)
INSERT INTO alerts(child_id, device_id, severity, category, domain, detail)
SELECT h.child_id, h.device_id, h.severity, h.category, h.domain,
       coalesce(h.note,'flagged domain') || ' (matched ' || h.pattern || ')'
FROM hits h
WHERE NOT EXISTS (
  SELECT 1 FROM alerts a
  WHERE a.child_id IS NOT DISTINCT FROM h.child_id
    AND a.category = h.category
    AND a.ts::date = CURRENT_DATE
)
RETURNING 1" 2>&1)
# A broken query used to print its ERROR to the terminal, count zero rows and
# say "nothing new" with exit 0, so systemd recorded success. A bash comment
# left inside this SQL string killed the whole alert path for a day and nothing
# said so. Stderr is captured and a failure is now loud and non-zero: an alert
# path that cannot run must never look like an alert path with nothing to say.
case "$rows" in
  *ERROR*)
    msg="The safety alert check failed, so no flagged domain has been noticed since: $(printf '%s' "$rows" | grep '^ERROR' | head -1 | tr -d "'" | cut -c1-150)"
    echo "genkan-alerts: $msg" >&2
    # The systemd unit that runs this uses ExecStartPost=- , so a non-zero exit
    # is ignored by design: a failed alert check must not fail the DNS ingest
    # that feeds it. That makes the exit status the wrong place to raise this.
    # So the failure is raised as an alert itself, where a parent already
    # looks, and retired by the next good run.
    psqll "INSERT INTO alerts(severity,category,detail)
           VALUES('urgent','alert-check','$(printf '%s' "$msg" | sed "s/'/''/g")')" >/dev/null 2>&1 || true
    exit 1;;
esac
# A good run retires the warnings from the bad ones before it.
psqll "UPDATE alerts SET acknowledged=true
       WHERE category='alert-check' AND NOT acknowledged" >/dev/null 2>&1 || true
# ^1$ anchored, not a bare 1. psql -tAc prints the returned rows AND the
# command tag, so "INSERT 0 1" also contains a 1 and an unanchored grep
# counted it: one new alert was reported as two, every single time.
n=$(printf '%s\n' "$rows" | grep -c '^1$' || true)

if [ "${n:-0}" -gt 0 ]; then
  echo "genkan-alerts: raised $n new alert(s)"
  psqll "SELECT coalesce(c.name,'unknown')||': '||a.severity||' '||a.category||' '||coalesce(a.domain,'')
         FROM alerts a LEFT JOIN children c ON c.id=a.child_id
         WHERE a.ts > now() - interval '2 minutes' ORDER BY a.ts DESC" | sed 's/^/  /'
else
  echo "genkan-alerts: nothing new"
fi
