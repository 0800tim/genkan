#!/usr/bin/env bash
# genkan:summary=Classify devices (personal / IoT / infrastructure) by hostname + MAC vendor.
#
# Runs after discovery. Guesses what each device IS so it can be treated right:
# a security camera or smart lock must never be metered or cut with "kids off",
# a phone should be assignable to a kid. Uses the device's announced hostname
# first (most reliable), then the MAC's manufacturer prefix (OUI), then the
# locally-administered bit (randomised MAC = almost always a personal phone).
# Curated, extend freely: many homes have the same handful of vendors.
set -uo pipefail
# Connects as kids_agent, a role with no superuser, no DDL and no
# COPY ... TO PROGRAM. See config/db/grants.sql for what it may touch and why.
PG_CONTAINER="${PG_CONTAINER:-postgres}"
DB_NAME="${GENKAN_DB:-kids_network}"
DB_ROLE="${GENKAN_DB_ROLE:-kids_agent}"
psqll(){ docker exec -i "$PG_CONTAINER" psql -U "$DB_ROLE" -d "$DB_NAME" -tAc "$1"; }

# Reclassify anything still on defaults (category personal + kind unknown), plus
# any device the parent has not overridden. Never touches infra or assigned ones.
# Only guess about devices nobody has decided on. A parent's choice, whether
# a class or an owner, must never be overwritten by the guesser: filing the
# SMS gateway as an appliance and finding it back under "personal" a minute
# later is worse than never guessing at all.
# --vendors re-derives ONLY the vendor, for every device, and touches nothing
# else. The rule above (never overwrite what a parent decided) is about kind,
# category, owner and label. A vendor is not a decision, it is read off the
# MAC, so a wrong one is simply wrong and should be corrected: 3c:0b:59 was
# listed as TP-Link when the registry says Tuya, and that bulb was described
# to a parent as a TP-Link device for two days (2026-09-04).
VENDORS_ONLY=0; [ "${1:-}" = "--vendors" ] && VENDORS_ONLY=1
if [ "$VENDORS_ONLY" = 1 ]; then
  rows=$(psqll "SELECT id||'|'||coalesce(lower(hostname),'')||'|'||lower(mac::text)
                FROM devices WHERE is_active")
else
  rows=$(psqll "SELECT id||'|'||coalesce(lower(hostname),'')||'|'||lower(mac::text)
                FROM devices
                WHERE kind IN ('unknown','')
                  AND category = 'personal'
                  AND child_id IS NULL
                  AND label IS NULL")
fi
[ -n "$rows" ] || { echo "genkan-classify: no devices"; exit 0; }

classify(){ # echoes: kind|category|vendor
  local host="$1" mac="$2" oui="${2:0:8}"
  # locally-administered bit set in first octet => randomised MAC (phones)
  local firstoct=$((16#${mac:0:2})); local random=$(( (firstoct & 2) != 0 ))
  local kind="" cat="personal" vendor=""
  # 1) hostname keywords (most reliable signal)
  case "$host" in
    *echo*|*alexa*|*amazon*)                 kind=speaker;   cat=iot; vendor=Amazon;;
    *sonos*)                                 kind=speaker;   cat=iot; vendor=Sonos;;
    *homepod*)                               kind=speaker;   cat=iot; vendor=Apple;;
    *roomba*|*irobot*|*braava*)              kind=vacuum;    cat=iot; vendor=iRobot;;
    *ring*|*doorbell*)                       kind=doorbell;  cat=iot; vendor=Ring;;
    *nest*|*wyze*|*reolink*|*hikvision*|*dahua*|*cam*|*camera*|*ipcam*|*frontdoor*|*backdoor*) kind=camera; cat=iot;;
    *lock*|*august*|*yale*|*schlage*|*lockly*) kind=lock;    cat=iot;;
    *hue*|*lifx*|*bulb*|*light*|*lamp*)      kind=light;     cat=iot;;
    *plug*|*wemo*|*kasa*|*smartplug*)        kind=plug;      cat=iot;;
    *thermostat*|*ecobee*|*honeywell*)       kind=thermostat;cat=iot;;
    *fridge*|*washer*|*dryer*|*oven*|*dishwasher*|*appliance*) kind=appliance; cat=iot;;
    *shelly*|*tasmota*|*tuya*|*sonoff*|*esp*|*esp32*|*esp8266*|*lwip*) kind=iot-generic; cat=iot;;
    *chromecast*|*roku*|*firetv*|*fire-tv*|*appletv*|*apple-tv*|*shield*|*-tv*|*smarttv*) kind=tv; cat=personal;;
    *ps5*|*ps4*|*playstation*|*xbox*|*nintendo*|*switch-*) kind=console; cat=personal;;
    *iphone*|*ipad*|*macbook*|*-mbp*|*-mba*) kind=personal;  cat=personal; vendor=Apple;;
    *galaxy*|*pixel*|*oneplus*|*android*|*-a12*|*-s2*|*-s23*|*redmi*|*xiaomi*) kind=phone; cat=personal;;
    *chromebook*|*chromeos*)                 kind=laptop;    cat=personal;;
    *macbook*|*laptop*|*-pc*|*desktop*|*thinkpad*) kind=laptop; cat=personal;;
  esac
  # 2) OUI vendor (fills vendor, and IoT category when hostname was silent)
  if [ -z "$vendor" ] || [ -z "$kind" ]; then
    case "$oui" in
      28:ee:52|50:c7:bf|a4:2b:b0|1c:61:b4|c0:06:c3) vendor=${vendor:-TP-Link};;
      # Tuya is the white-label platform behind a great many own-brand
      # plugs and bulbs, so the badge on the box is rarely 'Tuya'.
      3c:0b:59|d4:a6:51|68:57:2d|10:d5:61) vendor=${vendor:-Tuya}; [ -z "$kind" ] && { kind=iot-generic; cat=iot; };;
      # Anker's OUI, which is what a eufy lock, camera or doorbell wears.
      8c:85:80|a0:76:4e|e0:63:da) vendor=${vendor:-eufy-Anker}; [ -z "$kind" ] && { kind=iot-generic; cat=iot; };;
      fc:65:de|68:37:e9|44:65:0d|4c:ef:c0|ac:63:be|f0:81:73|68:54:fd) vendor=${vendor:-Amazon}; [ -z "$kind" ] && { kind=speaker; cat=iot; };;
      18:b4:30|64:16:66|d8:eb:46) vendor=${vendor:-Google-Nest}; [ -z "$kind" ] && { kind=camera; cat=iot; };;
      50:32:37|dc:a6:32|b8:27:eb|e4:5f:01) vendor=${vendor:-RaspberryPi};;
      24:0a:c4|30:ae:a4|84:0d:8e|a0:20:a6|ec:fa:bc|c8:2b:96|f4:cf:a2) vendor=${vendor:-Espressif}; [ -z "$kind" ] && { kind=iot-generic; cat=iot; };;
      00:0d:b9|9c:8e:cd) vendor=${vendor:-Ring}; [ -z "$kind" ] && { kind=doorbell; cat=iot; };;
      2c:aa:8e|d0:73:d5|00:17:88) vendor=${vendor:-Philips-Hue}; [ -z "$kind" ] && { kind=light; cat=iot; };;
      94:9f:3e|b8:e9:37|54:2a:1b) vendor=${vendor:-Sonos}; [ -z "$kind" ] && { kind=speaker; cat=iot; };;
      50:14:79) vendor=${vendor:-iRobot}; [ -z "$kind" ] && { kind=vacuum; cat=iot; };;
      e0:76:d0) vendor=${vendor:-WyzeLabs}; [ -z "$kind" ] && { kind=camera; cat=iot; };;
    esac
  fi
  # 3) randomised MAC with no other signal => a personal phone hiding its MAC
  if [ -z "$kind" ] && [ "$random" = 1 ]; then kind=phone; cat=personal; vendor=${vendor:-"(private MAC)"}; fi
  [ -z "$kind" ] && kind=unknown
  echo "$kind|$cat|$vendor"
}

# Read all rows into an array FIRST: docker exec -i inside the loop would
# otherwise slurp the loop's stdin and stop it after one row.
mapfile -t _devs <<< "$rows"
n=0
for line in "${_devs[@]}"; do
  [ -n "$line" ] || continue
  IFS='|' read -r id host mac <<< "$line"
  # The id is read back out of the database and then interpolated, so it is
  # checked rather than trusted. hostname and mac never reach SQL: they are
  # only ever matched against the case arms above.
  [[ "$id" =~ ^[0-9]{1,9}$ ]] || continue
  res=$(classify "$host" "$mac"); k=${res%%|*}; rest=${res#*|}; c=${rest%%|*}; v=${rest#*|}
  # kind, category and vendor all come from the case arms above, so they are
  # this script's own literals. Quote-doubled anyway: one day somebody adds an
  # arm that reads a vendor name out of the database.
  vset=""; [ -n "$v" ] && vset=", vendor='$(printf '%s' "$v" | sed "s/'/''/g")'"
  if [ "$VENDORS_ONLY" = 1 ]; then
    [ -n "$v" ] || continue
    psqll "UPDATE devices SET vendor='$(printf '%s' "$v" | sed "s/'/''/g")' WHERE id=$id" >/dev/null
  else
    psqll "UPDATE devices SET kind='$k', category='$c'$vset WHERE id=$id" >/dev/null
  fi
  n=$((n+1))
done
[ "$VENDORS_ONLY" = 1 ] && echo "genkan-classify: refreshed the vendor on $n device(s)" \
  || echo "genkan-classify: classified $n device(s)"
