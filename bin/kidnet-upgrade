#!/usr/bin/env bash
# hearth:summary=Update Hearth safely: check first, snapshot, apply, and undo itself if it breaks.
#
#   kidnet-upgrade                  what is available, what would change. Changes NOTHING.
#   kidnet-upgrade check            the same thing, spelled out
#   sudo kidnet-upgrade apply       do it
#   kidnet-upgrade status           what is running now, and what happened last time
#
# Options for `apply`
#   --to <ref>        a specific release, branch or commit (default: the newest release)
#   --yes             do not ask
#   --dry-run         print every step without doing any of it. No root needed.
#   --allow-dirty     proceed even though this box has local edits (they are
#                     snapshotted first, then overwritten). See below.
#   --no-auto-rollback  leave a failed upgrade in place for a human to look at
#   --wait <seconds>  how long to give the box to come back before judging it (default 150)
#
# ---------------------------------------------------------------------------
# WHY THIS IS BUILT THE WAY IT IS
#
# Hearth sits between a household and the internet. A bad update here does not
# mean a broken app: it means the children cannot do their homework, and the
# parent cannot fix it because the dashboard is down too. So the order of
# operations is not negotiable:
#
#   1. CHECK THE NEW VERSION BEFORE SWITCHING TO IT. The firewall ruleset has
#      to parse (`nft -c`), the database schema has to load from empty
#      (test/schema-test.sh), and every script has to be syntactically valid.
#      All three run against the NEW code, in a throwaway checkout, while the
#      live box carries on untouched. If any of them fail, nothing changes and
#      the household never notices there was an upgrade.
#   2. SNAPSHOT BEFORE CHANGING ANYTHING. The database, the exact commit, and
#      any uncommitted edits on this box.
#   3. APPLY, then ask the box whether it is actually working.
#   4. IF IT IS NOT, PUT THE OLD ONE BACK, without waiting to be asked. A
#      parent should not have to know how to do that at 9pm.
#
# The undo tool is copied INTO the snapshot before the switchover, and it is
# that copy which runs a rollback. The reason is blunt: if the new version is
# broken enough to fail its health check, its own rollback script cannot be
# trusted to be the thing that saves you.
#
# SAFE TO RUN TWICE: an upgrade to a version already installed exits saying so
# and touches nothing. SAFE TO INTERRUPT: a run that is killed part way leaves
# a marker, and the next run picks that marker up, finishes the job, and rolls
# back if the box is not healthy.
#
# WHAT THIS CANNOT DO: see the limits section in docs/UPGRADING.md. The short
# version is that a rollback restores code and, if you ask for it, the
# database as it was at the snapshot. It cannot un-drop a database column, it
# cannot recover minutes a child earned after the snapshot if you choose to
# restore the database, and it cannot fix a broken upstream: if the household
# broadband is down, no version of Hearth will look healthy.
# ---------------------------------------------------------------------------
set -uo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
[ -f "$HERE/kidnet-release-lib.sh" ] || { echo "kidnet-upgrade: kidnet-release-lib.sh is missing from $HERE"; exit 2; }
. "$HERE/kidnet-release-lib.sh"
[ -n "$R" ] || { echo "kidnet-upgrade: cannot find the Hearth checkout. Set HEARTH_ROOT, or run
  sudo ./deploy.sh once from your copy so it can record where the code lives."; exit 2; }

YES=0; DRY=0; ALLOW_DIRTY=0; AUTO_ROLLBACK=1; TARGET=""; WAIT="$HEARTH_HEALTH_WAIT"
CMD="${1:-check}"; [ $# -gt 0 ] && shift
case "$CMD" in check|apply|status) ;; -h|--help) sed -n '3,60p' "$0" | sed 's/^# \{0,1\}//'; exit 0;;
  *) echo "kidnet-upgrade: unknown command '$CMD' (check, apply, status)"; exit 2;; esac
while [ $# -gt 0 ]; do
  case "$1" in
    --to) TARGET="${2:?--to needs a release, branch or commit}"; shift;;
    --yes|-y) YES=1;;
    --dry-run) DRY=1;;
    --allow-dirty) ALLOW_DIRTY=1;;
    --no-auto-rollback) AUTO_ROLLBACK=0;;
    --wait) WAIT="${2:?--wait needs seconds}"; shift;;
    *) echo "kidnet-upgrade: unknown option '$1'"; exit 2;;
  esac
  shift
done
case "$WAIT" in *[!0-9]*) echo "kidnet-upgrade: --wait takes seconds"; exit 2;; esac

say(){ printf '%s\n' "$*"; }
step(){ printf '\n==> %s\n' "$*"; }
die(){ printf '\nkidnet-upgrade: %s\n' "$*" >&2; exit 1; }
run(){ if [ "$DRY" = 1 ]; then printf '   would run: %s\n' "$*"; return 0; else "$@"; fi; }

git_ok || die "$R is not a git checkout, so there is nothing to upgrade from. Reinstall from a fresh copy instead."

# ---------------------------------------------------------------------------
# status
# ---------------------------------------------------------------------------
if [ "$CMD" = status ]; then
  say ""
  say "$(hearth_version_line)"
  say "  commit  $(hearth_short)"
  say "  code    $R"
  say "  state   $HEARTH_STATE_DIR"
  ids="$(snapshot_list)"
  if [ -n "$ids" ]; then
    say ""
    say "Points you can go back to (newest first):"
    for id in $ids; do
      printf '  %s  from %s  %s\n' "$id" "$(snapshot_field "$id" from_version 2>/dev/null || echo '?')" \
        "$( [ -f "$(snapshot_dir "$id")/db.sql.gz" ] && echo 'code + database' || echo 'code only' )"
    done
  else
    say ""
    say "No snapshots yet. The first upgrade will make one."
  fi
  if [ -f "$HEARTH_STATE_DIR/in-progress" ]; then
    say ""
    say "WARNING: an upgrade was interrupted (snapshot $(cat "$HEARTH_STATE_DIR/in-progress"))."
    say "Run 'sudo kidnet-upgrade apply' to finish it, or 'sudo kidnet-rollback to previous'."
  fi
  say ""
  docker exec -i "$PG_CONTAINER" psql -U "$HEARTH_DB_ROLE" -d "$HEARTH_DB" -qtAc \
    "SELECT to_char(ts,'DD Mon HH24:MI')||'  '||action||'  '||coalesce(from_version,'?')||' -> '||coalesce(to_version,'?')
       ||CASE WHEN ok THEN '' ELSE '   (FAILED, undone)' END FROM release_log LIMIT 10" 2>/dev/null \
    | sed 's/^/  /' | grep . && say "" || true
  exit 0
fi

# ---------------------------------------------------------------------------
# Work out where we are and where we would be going
# ---------------------------------------------------------------------------
FROM_COMMIT="$(g rev-parse HEAD)"
FROM_VERSION="$(hearth_version)"
FROM_REF="$(g rev-parse --abbrev-ref HEAD)"
REMOTE="$(g remote 2>/dev/null | head -1)"

step "Looking for a newer version of Hearth"
if [ -z "$REMOTE" ]; then
  say "   This copy has no remote to fetch from, so only a local --to can be used."
else
  if [ "$DRY" = 1 ]; then say "   would run: git fetch --tags $REMOTE"
  elif g fetch --tags --quiet "$REMOTE" 2>/dev/null; then say "   fetched from $REMOTE"
  else say "   could not reach $REMOTE. Working from what is already downloaded."
  fi
fi

if [ -n "$TARGET" ]; then
  TO_COMMIT="$(g rev-parse -q --verify "$TARGET^{commit}" 2>/dev/null)" \
    || die "'$TARGET' is not a release, branch or commit this copy knows about."
  TO_LABEL="$TARGET"
else
  # The default channel is releases, not the tip of a branch. A household
  # should get versions somebody decided to call finished, never whatever was
  # committed twenty minutes ago. `--to origin/main` is there for the person
  # who genuinely wants the edge, and docs/UPGRADING.md says who that is.
  TO_LABEL="$(g tag -l 'v[0-9]*' --sort=-v:refname 2>/dev/null | head -1)"
  [ -n "$TO_LABEL" ] || die "no releases found. This copy has no version tags, so there is nothing to upgrade to. Try --to origin/main if you deliberately want the development branch."
  TO_COMMIT="$(g rev-parse "$TO_LABEL^{commit}")"
fi
TO_VERSION="$(g show "$TO_COMMIT:VERSION" 2>/dev/null | tr -d ' \t\r\n')"
[ -n "$TO_VERSION" ] || TO_VERSION="${TO_LABEL#v}"

RESUMING=0
[ -f "$HEARTH_STATE_DIR/in-progress" ] && RESUMING=1

if [ "$TO_COMMIT" = "$FROM_COMMIT" ] && [ "$RESUMING" = 0 ]; then
  say ""
  say "You are already running $TO_LABEL (Hearth $FROM_VERSION). Nothing to do."
  say ""
  exit 0
fi

say ""
say "  Running now:  Hearth $FROM_VERSION  ($(g rev-parse --short "$FROM_COMMIT"))"
say "  Available:    Hearth $TO_VERSION  ($TO_LABEL, $(g rev-parse --short "$TO_COMMIT"))"
n="$(g rev-list --count "$FROM_COMMIT..$TO_COMMIT" 2>/dev/null || echo '?')"
say "  That is $n change(s) newer than what this box is running."
if [ "$CMD" = check ]; then
  say ""
  say "  What changed:"
  g log --no-merges --format='    %s' "$FROM_COMMIT..$TO_COMMIT" 2>/dev/null | head -20
  # A schema change is the one kind of change a rollback cannot fully undo, so
  # it gets called out before anybody agrees to anything.
  if g diff --name-only "$FROM_COMMIT..$TO_COMMIT" -- config/db/ 2>/dev/null | grep -q .; then
    say ""
    say "  NOTE: this update changes the database structure. The upgrade will take"
    say "  a full backup first. Read the limits in docs/UPGRADING.md before you go"
    say "  ahead: undoing a database change is not always possible."
  fi
  say ""
  say "  Nothing has been changed. To install it:  sudo kidnet-upgrade apply"
  say ""
  exit 0
fi

# ---------------------------------------------------------------------------
# apply
# ---------------------------------------------------------------------------
[ "$DRY" = 1 ] || [ "$(id -u)" = 0 ] || die "run with sudo (it restarts containers and writes to /usr/local/bin). Add --dry-run to see the steps without root."

if [ "$DRY" = 0 ]; then
  mkdir -p "$HEARTH_STATE_DIR" || die "cannot create $HEARTH_STATE_DIR"
  # One upgrade at a time, and a second one says so rather than interleaving
  # with the first. The lock is released when this process exits, whatever way
  # it exits, because the kernel owns it and not us.
  exec 9>"$HEARTH_STATE_DIR/upgrade.lock" || die "cannot open the upgrade lock"
  flock -n 9 || die "another upgrade is already running. Wait for it to finish."
fi

# --- picking an interrupted run back up ------------------------------------
if [ "$RESUMING" = 1 ]; then
  PREV="$(cat "$HEARTH_STATE_DIR/in-progress")"
  step "Finishing an upgrade that was interrupted (snapshot $PREV)"
  say "   Nothing new will be downloaded. The box is put into a known state first."
  SNAP="$(snapshot_dir "$PREV")"
  [ -d "$SNAP" ] || die "snapshot $PREV is missing, so the interrupted upgrade cannot be finished automatically. Run: sudo kidnet-rollback list"
  ID="$PREV"
  TO_COMMIT="$(snapshot_field "$ID" to_commit)"
  TO_VERSION="$(snapshot_field "$ID" to_version)"
  FROM_COMMIT="$(snapshot_field "$ID" from_commit)"
  FROM_VERSION="$(snapshot_field "$ID" from_version)"
else
  # --- 1. check the new version, before touching anything ------------------
  step "Checking the new version before switching to it"
  TMPW="$(mktemp -d "${TMPDIR:-/tmp}/hearth-upgrade-XXXXXX")"
  cleanup_worktree(){ [ -n "${TMPW:-}" ] && { g worktree remove --force "$TMPW" >/dev/null 2>&1 || rm -rf "$TMPW"; }; g worktree prune >/dev/null 2>&1 || true; }
  trap cleanup_worktree EXIT
  if [ "$DRY" = 1 ]; then
    say "   would check out $TO_LABEL into a throwaway directory and run:"
    say "     nft -c -f config/nftables/kids.nft      the firewall ruleset parses"
    say "     test/schema-test.sh                     the database loads from empty"
    say "     bash -n on every script                 nothing is half-edited"
  else
    g worktree add --detach --quiet "$TMPW" "$TO_COMMIT" 2>/dev/null \
      || die "could not check the new version out into a throwaway directory."

    say "   the firewall ruleset..."
    if [ -f "$TMPW/config/nftables/kids.nft" ]; then
      out="$(/usr/sbin/nft -c -f "$TMPW/config/nftables/kids.nft" 2>&1)" \
        || die "REFUSING TO UPGRADE: the new firewall ruleset does not parse. Nothing has been changed.
$out"
      say "     ok"
    else
      die "REFUSING TO UPGRADE: the new version has no config/nftables/kids.nft. Nothing has been changed."
    fi

    say "   every script parses..."
    bad=""
    for f in "$TMPW"/bin/* "$TMPW"/deploy.sh "$TMPW"/tools/*.sh "$TMPW"/test/*.sh "$TMPW"/config/db/load.sh; do
      [ -f "$f" ] || continue
      head -1 "$f" | grep -qE '^#!.*(bash|/sh)' || continue
      bash -n "$f" 2>/dev/null || bad="$bad $(basename "$f")"
    done
    [ -z "$bad" ] || die "REFUSING TO UPGRADE: these scripts in the new version are not valid shell:$bad. Nothing has been changed."
    say "     ok"

    say "   the database schema loads from empty..."
    if [ -x "$TMPW/test/schema-test.sh" ]; then
      if ! out="$(bash "$TMPW/test/schema-test.sh" 2>&1)" || printf '%s' "$out" | grep -q FAIL; then
        printf '%s\n' "$out" | grep -E 'FAIL|failed' | head -10 | sed 's/^/     /'
        die "REFUSING TO UPGRADE: the new version's database schema does not load. Nothing has been changed."
      fi
      say "     ok ($(printf '%s' "$out" | sed -n 's/^passed \([0-9]*\).*/\1/p' | tail -1) checks)"
    else
      say "     skipped: the new version has no test/schema-test.sh"
    fi
    cleanup_worktree; trap - EXIT; TMPW=""
  fi

  # --- 2. local edits ------------------------------------------------------
  if [ -n "$(g status --porcelain 2>/dev/null)" ]; then
    step "This box has local edits"
    run bash "$R/tools/worktree-snapshot.sh" save
    say "   They have been snapshotted (tools/worktree-snapshot.sh list)."
    if [ "$ALLOW_DIRTY" = 0 ]; then
      die "there are edits here that are not committed. They are safe in the snapshot above,
but an upgrade would overwrite the working copy of them. Either commit them, or
re-run with --allow-dirty if you are sure they can be replaced.
Recover a file later with: tools/worktree-snapshot.sh restore <ref> <path>"
    fi
    say "   --allow-dirty given: they will be overwritten. Recover with tools/worktree-snapshot.sh restore."
  fi

  # --- 3. confirm ----------------------------------------------------------
  if [ "$YES" = 0 ] && [ "$DRY" = 0 ]; then
    say ""
    printf 'Upgrade this household from Hearth %s to %s? [y/N] ' "$FROM_VERSION" "$TO_VERSION"
    read -r ans </dev/tty || ans=""
    case "$ans" in y|Y|yes|YES) ;; *) say "Nothing was changed."; exit 0;; esac
  fi

  # --- 4. snapshot ---------------------------------------------------------
  ID="$(date +%Y%m%d-%H%M%S)"
  SNAP="$(snapshot_dir "$ID")"
  step "Taking a snapshot to come back to ($ID)"
  run mkdir -p "$SNAP"
  WT_REF="$(g rev-parse -q --verify refs/hearth/snapshots 2>/dev/null || true)"
  if [ "$DRY" = 0 ]; then
    {
      echo "id=$ID"
      echo "date=$(date -Is)"
      echo "from_version=$FROM_VERSION"
      echo "from_commit=$FROM_COMMIT"
      echo "from_ref=$FROM_REF"
      echo "to_version=$TO_VERSION"
      echo "to_commit=$TO_COMMIT"
      echo "to_label=$TO_LABEL"
      echo "worktree_ref=$WT_REF"
      echo "root=$R"
    } > "$SNAP/manifest.env"
  else
    say "   would write $SNAP/manifest.env"
  fi

  say "   the database..."
  # SUPERUSER PATH, deliberately. A backup has to be able to read every table
  # including ones kids_agent has no grant on, and pg_dump as a restricted
  # role produces a dump that silently misses things, which is worse than no
  # backup at all because it looks like one. It runs on a fixed command line
  # with no operator-supplied values in it.
  if [ "$DRY" = 1 ]; then
    say "   would run: docker exec $PG_CONTAINER pg_dump --clean --if-exists -U postgres -d $HEARTH_DB | gzip > $SNAP/db.sql.gz"
  elif docker exec -i "$PG_CONTAINER" pg_dump --clean --if-exists -U postgres -d "$HEARTH_DB" 2>/dev/null \
        | gzip -c > "$SNAP/db.sql.gz.part" && [ -s "$SNAP/db.sql.gz.part" ]; then
    mv -f "$SNAP/db.sql.gz.part" "$SNAP/db.sql.gz"
    echo "db_bytes=$(stat -c %s "$SNAP/db.sql.gz")" >> "$SNAP/manifest.env"
    say "     ok ($(du -h "$SNAP/db.sql.gz" | cut -f1))"
  else
    rm -f "$SNAP/db.sql.gz.part"
    die "could not back the database up, so the upgrade stops here. Nothing has been changed.
Check that the '$PG_CONTAINER' container is running."
  fi

  # The undo tool travels with the thing it can undo. If the new version turns
  # out to be broken, its own rollback script is the last thing that should be
  # trusted to fix it.
  if [ "$DRY" = 0 ]; then
    for f in kidnet-rollback kidnet-release-lib.sh kidnet-health; do
      [ -f "$HERE/$f" ] && cp -f "$HERE/$f" "$SNAP/$f"
    done
    chmod 0755 "$SNAP/kidnet-rollback" "$SNAP/kidnet-health" 2>/dev/null || true
    say "   the undo tool has been copied into the snapshot."
  fi
fi

# --- 5. switch over --------------------------------------------------------
[ "$DRY" = 0 ] && { echo "$ID" > "$HEARTH_STATE_DIR/in-progress"; echo "applying" > "$SNAP/phase"; }
step "Installing Hearth $TO_VERSION"
if [ "$DRY" = 1 ]; then
  say "   would run: git checkout --detach $TO_COMMIT"
  say "   would run: ${HEARTH_APPLY_CMD:-bash $R/deploy.sh}"
else
  g -c advice.detachedHead=false checkout --force --detach "$TO_COMMIT" --quiet \
    || die "could not switch the code over. Nothing else has been changed; the snapshot is $ID."
  if [ -n "$HEARTH_APPLY_CMD" ]; then
    # shellcheck disable=SC2086
    ( cd "$R" && eval "$HEARTH_APPLY_CMD" ) || say "   the apply step reported a problem; the health check below decides what happens next."
  else
    ( cd "$R" && bash "$R/deploy.sh" ) || say "   deploy reported a problem; the health check below decides what happens next."
  fi
  echo "applied" > "$SNAP/phase"
fi

# --- 6. is the household actually working? ---------------------------------
step "Checking the household's internet"
if [ "$DRY" = 1 ]; then
  say "   would run: kidnet-health --wait $WAIT"
  say ""
  say "   (dry run: nothing above was actually done)"
  exit 0
fi
if "$R/bin/kidnet-health" --wait "$WAIT"; then
  echo "done" > "$SNAP/phase"
  rm -f "$HEARTH_STATE_DIR/in-progress"
  release_record upgrade "$FROM_VERSION" "$FROM_COMMIT" "$TO_VERSION" "$TO_COMMIT" "$ID" true "upgraded and healthy"
  # Keep a handful of ways back and no more. Each snapshot is a compressed
  # database dump, and a box that fills its disk with backups is a box that
  # has broken itself in a new and interesting way.
  keep="$HEARTH_KEEP_SNAPSHOTS"
  snapshot_list | tail -n +$((keep+1)) | while read -r old; do rm -rf "$(snapshot_dir "$old")"; done
  step "Done"
  say "   Hearth $TO_VERSION is installed and the household is healthy."
  say "   If something turns out to be wrong later:  sudo kidnet-rollback to $ID"
  say ""
  exit 0
fi

# --- 7. it is not working --------------------------------------------------
say ""
say "  The health check FAILED after the upgrade."
release_record upgrade "$FROM_VERSION" "$FROM_COMMIT" "$TO_VERSION" "$TO_COMMIT" "$ID" false "health check failed after upgrade"
if [ "$AUTO_ROLLBACK" = 0 ]; then
  echo "applied" > "$SNAP/phase"
  say "  --no-auto-rollback was given, so the new version has been left in place."
  say "  Put the old one back with:  sudo kidnet-rollback to $ID"
  say ""
  exit 1
fi
step "Putting Hearth $FROM_VERSION back"
say "   Nobody has to do anything. This is automatic."
# The snapshot's own copy of the rollback tool, for the reason given above.
RB="$SNAP/kidnet-rollback"; [ -x "$RB" ] || RB="$HERE/kidnet-rollback"
if HEARTH_ROOT="$R" HEARTH_STATE_DIR="$HEARTH_STATE_DIR" bash "$RB" to "$ID" --yes --auto; then
  rm -f "$HEARTH_STATE_DIR/in-progress"
  say ""
  say "  Hearth $FROM_VERSION is back and the household is working again."
  say "  The version that failed was $TO_VERSION. Please report it:"
  say "      https://github.com/0800tim/hearth/issues"
  say ""
  exit 1
fi
say ""
say "  THE ROLLBACK ALSO FAILED. This needs a person."
say "  Snapshot: $SNAP"
say "  The old code was commit $FROM_COMMIT and the database backup is"
say "  $SNAP/db.sql.gz. docs/UPGRADING.md has the by-hand recovery steps."
say ""
exit 1
