#!/usr/bin/env bash
# genkan:summary=Sync AdGuard's per-child clients to the real assigned device IPs and to their filter level.
#
# AdGuard applies the age tier (SafeSearch, blocked services, per-client rules)
# by CLIENT, and a client is identified by IP. Those IPs must therefore track
# whichever devices a parent has actually assigned to each child, otherwise the
# tiers land on the wrong devices (a stale seed config had Cleo's tier pointed
# at addresses that later belonged to a parent's phone).
#
# Run after any device assignment and after any change to a filter level.
# Idempotent, and never touches the household catch-all client.
#
# WHO GETS A CLIENT OF THEIR OWN (see docs/HOUSEHOLD-ROLES.md):
#   child        yes, their age tier
#   guest-child  yes. A visiting kid must be filtered like a kid, and an exact
#                IP match beats the household catch-all's subnet match, so the
#                child tier wins on their device and only their device.
#   guest-adult  yes, but the light 'guest' level: malware and adult content,
#                nothing else, and their queries are not logged individually.
#                Without a client of their own they would fall through to the
#                household catch-all, which does not block adult content.
#   adult        NO. A household adult is effectively unrestricted, which is
#                exactly what the catch-all already gives them.
# People marked inactive (a guest who has gone home) are treated as having no
# devices, so their tier stops applying the moment they leave.
#
# A SHARED FAMILY DEVICE gets a client of its own too, named after the device.
# The family television belongs to nobody, so no person's tier can carry it,
# and without a client of its own it falls through to the household catch-all,
# which blocks ads and malware and nothing else. An unfiltered television in
# the lounge is a worse outcome than a wrongly billed one, which is the whole
# reason the shared class exists. Its level is devices.policy_tier, set by
# `genkan shared` or on the Devices page. Clear the level and the client is
# removed, the same as for a guest who has gone home.
#
# A shared device whose label is also a person's name is skipped: AdGuard keys
# clients by name, so building it would overwrite that person's client.
#
# WHAT A LEVEL MEANS lives in the policies table since 2026-09-02
# (config/db/schema-settings.sql): parental control, SafeSearch, the blocked
# services and the private flag, edited with `genkan tier set` or on the
# dashboard's Settings page. The database wins: a client whose settings differ
# from its level is brought back to the level on every run, the same way the
# gateway rebuilds its firewall sets from the database rather than trusting
# what it finds. Before this date an existing client was never re-templated,
# so a parent could tune one in the AdGuard UI and keep it; that is no longer
# where the tuning lives, and the Settings page says so. Only the fields a
# level owns are written (parental, SafeSearch, blocked services, the log
# flags); upstreams, tags and anything else on the client are left alone.
#
# The global blocklists (OISD and friends) are NOT per client. AdGuard cannot
# apply a filter list to one client and not another, so they stay global and
# a level cannot change them.
set -uo pipefail
: "${ADGUARD_URL:=http://127.0.0.1:8853}" "${ADGUARD_USER:=admin}" "${ADGUARD_PASS:?set ADGUARD_PASS}"
# Connects as kids_agent, a role with no superuser, no DDL and no
# COPY ... TO PROGRAM. See config/db/grants.sql for what it may touch and why.
PG_CONTAINER="${PG_CONTAINER:-postgres}"
DB_NAME="${GENKAN_DB:-kids_network}"
DB_ROLE="${GENKAN_DB_ROLE:-kids_agent}"
psqll(){ docker exec -i "$PG_CONTAINER" psql -U "$DB_ROLE" -d "$DB_NAME" -tAc "$1"; }

MAP=$(psqll "
  SELECT c.name||'|'||c.policy_tier||'|'||c.kind||'|'
         ||CASE WHEN c.active THEN '1' ELSE '0' END||'|'
         ||coalesce(string_agg(host(d.reserved_ip), ',' ORDER BY d.reserved_ip), '')
  FROM children c
  LEFT JOIN devices d ON d.child_id=c.id AND d.reserved_ip IS NOT NULL
        AND d.is_active AND d.category='personal' AND c.active
  WHERE c.kind IN ('child','guest-child','guest-adult')
  GROUP BY c.name, c.policy_tier, c.kind, c.active
  UNION ALL
  SELECT d.label||'|'||coalesce(d.policy_tier,'standard')||'|shared-device|'
         ||CASE WHEN d.policy_tier IS NULL THEN '0' ELSE '1' END||'|'
         ||host(d.reserved_ip)
  FROM devices d
  WHERE d.category='shared' AND d.is_active AND d.reserved_ip IS NOT NULL
    AND d.label IS NOT NULL AND d.label <> '' AND d.label NOT LIKE '%|%'
    AND NOT EXISTS (SELECT 1 FROM children c WHERE lower(c.name)=lower(d.label))")
[ -n "$MAP" ] || { echo "genkan-adguard-clients: nobody who needs a client of their own"; exit 0; }

# The levels themselves. A database that has not loaded schema-settings.sql
# yet has no adguard_* columns, the query fails, and the script falls back to
# the table it always carried, which holds the same values.
TIERS=$(psqll "
  SELECT tier||'|'||adguard_parental||'|'||safesearch||'|'
         ||array_to_string(adguard_services,',')||'|'||adguard_private
  FROM policies ORDER BY tier" 2>/dev/null) || TIERS=""

ADGUARD_URL="$ADGUARD_URL" ADGUARD_USER="$ADGUARD_USER" ADGUARD_PASS="$ADGUARD_PASS" \
MAP="$MAP" TIERS="$TIERS" python3 <<'PY'
import os,json,base64,urllib.request
BASE=os.environ["ADGUARD_URL"]
auth=base64.b64encode(f'{os.environ["ADGUARD_USER"]}:{os.environ["ADGUARD_PASS"]}'.encode()).decode()
def call(path,data=None):
    r=urllib.request.Request(BASE+path,data=(json.dumps(data).encode() if data else None),
                             method=("POST" if data else "GET"))
    r.add_header("Authorization","Basic "+auth); r.add_header("Content-Type","application/json")
    b=urllib.request.urlopen(r,timeout=10).read()
    return json.loads(b) if b else {}
# The fallback filter level for each tier, used ONLY when the database has not
# been given config/db/schema-settings.sql yet. These are the values that file
# seeds, so the two can never disagree on a fresh box.
#
# 'adult' is absent on purpose: household adults get no client of their own.
TEMPLATES={
  "young":  dict(parental=True,  safesearch=True,  services=[
      "4chan","9gag","tiktok","instagram","snapchat","twitter","reddit","twitch",
      "discord","onlyfans","tinder","grindr"]),
  "standard": dict(parental=True, safesearch=True,  services=["4chan","onlyfans","tinder","grindr"]),
  "teen":   dict(parental=False, safesearch=False, services=["onlyfans","tinder","grindr"]),
  # A visiting adult: block malware (safebrowsing) and adult content (parental),
  # and nothing else. No SafeSearch, no blocked services, no time limit, and
  # their queries are kept out of the individual log, which is the promise the
  # guest level makes.
  "guest":  dict(parental=True,  safesearch=False, services=[], private=True),
}
# What the database says a level means, when it can say. One line per level:
# tier|parental|safesearch|service,service,...|private
LEVELS={}
for line in os.environ.get("TIERS","").splitlines():
    if not line.strip(): continue
    tier,parental,safesearch,services,private=line.split("|",4)
    LEVELS[tier.strip()]=dict(parental=(parental.strip()=="true"), safesearch=(safesearch.strip()=="true"),
                              services=[s for s in services.split(",") if s.strip()],
                              private=(private.strip()=="true"))
source="the database" if LEVELS else "the built-in table (schema-settings.sql not loaded)"
def level(tier):
    src=LEVELS or TEMPLATES
    return src.get(tier) or src.get("standard") or TEMPLATES["standard"]
# AdGuard's own tag vocabulary, so a client Genkan creates looks like one a
# person created in the UI. Nothing here depends on the tag; it is there so the
# AdGuard query log reads sensibly.
TAGS={"young":["user_child"],"standard":["user_child"],"teen":["user_child"],
      "guest":["user_regular"],"adult":["user_admin"]}
# The fields a level OWNS on a client. Everything else on the client object
# (upstreams, tags, the name) is the client's own and is never touched.
def policy(tier):
    t=level(tier)
    ss=bool(t["safesearch"])
    return {
      "parental_enabled": bool(t["parental"]),
      "safesearch_enabled": ss,
      "safe_search": {"enabled": ss, "bing": True, "duckduckgo": True, "ecosia": True,
                      "google": True, "pixabay": True, "yandex": True, "youtube": True},
      "use_global_blocked_services": False, "blocked_services": sorted(t["services"]),
      "ignore_querylog": bool(t.get("private")), "ignore_statistics": bool(t.get("private")),
    }
def template(name, tier, ips):
    c={"name": name, "ids": ips, "tags": TAGS.get(tier,[]), "upstreams": [],
       "use_global_settings": False, "filtering_enabled": True, "safebrowsing_enabled": True}
    c.update(policy(tier))
    return c
# Which of a level's fields a client has drifted from. Compared field by field
# so the log line can say what moved, and so a client AdGuard has decorated
# with extra keys still compares equal when nothing that matters changed.
def drift(c, pol):
    out=[]
    for k in ("parental_enabled","safesearch_enabled","use_global_blocked_services","ignore_querylog","ignore_statistics"):
        if bool(c.get(k))!=pol[k]: out.append(k)
    if sorted(c.get("blocked_services") or [])!=pol["blocked_services"]: out.append("blocked_services")
    if bool((c.get("safe_search") or {}).get("enabled"))!=pol["safe_search"]["enabled"]: out.append("safe_search")
    return out

want={}
for line in os.environ["MAP"].splitlines():
    if not line.strip(): continue
    name,tier,role,active,ips=line.split("|",4)
    want[name.strip()]=( tier.strip(), role.strip(), active.strip()=="1",
                         [i for i in ips.split(",") if i.strip()] )
clients={c.get("name"):c for c in (call("/control/clients").get("clients") or [])}
changed=0

# Every identifier AdGuard is already using. AdGuard refuses two clients with
# the same identifier, so a parking address has to be one nothing else holds.
# Numbering the parked clients 1, 2, 3 in whatever order the query returned them
# (which is what this did before) collides the moment one child already sits on
# 192.0.2.1 and a different one is handed the same number: the update is
# rejected and that client quietly keeps its old, real address, which is the
# exact failure this tool exists to prevent. So the address is chosen from what
# is actually free.
in_use=set()
for c in clients.values():
    for i in (c.get("ids") or []): in_use.add(i)
def park_address(cur_ids):
    cur=set(cur_ids or [])
    for n in range(1,255):
        a="192.0.2.%d" % n            # TEST-NET-1, RFC 5737, never routable
        if a in cur: return a         # already parked there, leave it be
        if a not in in_use:
            in_use.add(a); return a
    return None

for name,(tier,role,active,ips) in want.items():
    c=clients.get(name)
    if not active:
        # A guest who has gone home, or a shared device whose filter level has
        # been cleared. Their client is deleted rather than parked:
        # AdGuard's client list is a list of the people in the house, and it
        # should not slowly fill with strangers. If they come back, the block
        # below builds it again from their level the moment they have a device.
        if c:
            try:
                call("/control/clients/delete",{"name":name})
                for i in (c.get("ids") or []): in_use.discard(i)
                print(f"  {name}: gone home, AdGuard client removed")
                changed+=1
            except Exception as e:
                print(f"  {name}: could not remove their AdGuard client ({e})")
        continue
    if not c:
        # A guest arrives, gets a device, and their filtering has to work now,
        # not after somebody remembers to open the AdGuard UI. Create the client
        # from their level. AdGuard refuses a client with no identifier at all,
        # so somebody with no device yet is created parked on an unroutable
        # address: the client is ready, and it matches nothing until they have
        # something to match.
        use = ips or [park_address(None)]
        try:
            # /control/clients/add takes the client object directly; only
            # /control/clients/update wraps it in {name, data}.
            call("/control/clients/add",template(name,tier,use))
            for i in use: in_use.add(i)
            print(f"  {name}: created a {tier} client on {', '.join(use)}"
                  + ("" if ips else " (parked; it matches nothing until they have a device)"))
            changed+=1
        except Exception as e:
            print(f"  {name}: could not create the AdGuard client ({e}); create one named {name} by hand")
        continue
    new=dict(c); notes=[]
    if not ips:
        # A child with no assigned devices must match NOTHING. Leaving stale
        # IDs behind is the exact bug this tool exists to fix: the tier would
        # keep applying to whatever device later inherited that address.
        # AdGuard refuses a client with no identifiers, so park it on a
        # TEST-NET-1 address (RFC 5737, reserved for documentation and never
        # routable), which is the closest thing to "matches nothing".
        # Unique per child: AdGuard requires client identifiers to be unique,
        # so the address comes from park_address(), which picks one nothing
        # else is holding rather than counting 1, 2, 3 and hoping.
        PARK=park_address(c.get("ids"))
        if PARK and c.get("ids")!=[PARK]:
            for i in (c.get("ids") or []): in_use.discard(i)
            new["ids"]=[PARK]
            notes.append(f"no assigned devices, parked on {PARK} so it matches nothing")
    elif sorted(c.get("ids") or [])!=sorted(ips):
        for i in (c.get("ids") or []): in_use.discard(i)
        for i in ips: in_use.add(i)
        new["ids"]=ips
        notes.append(f"ids -> {', '.join(ips)}")
    # The level. The database wins over whatever the client currently says.
    pol=policy(tier)
    moved=drift(c,pol)
    if moved:
        new.update(pol)
        notes.append(f"{tier} level applied ({', '.join(moved)})")
    if not notes:
        if not ips: print(f"  {name}: no assigned devices")
        continue
    try:
        call("/control/clients/update",{"name":name,"data":new})
        print(f"  {name}: " + "; ".join(notes))
        changed+=1
    except Exception as e:
        print(f"  {name}: could not update ({e}); " + "; ".join(notes) + " NOT applied")
print(f"genkan-adguard-clients: {changed} client(s) updated, levels from {source}")
PY
