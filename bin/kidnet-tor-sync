#!/usr/bin/env bash
# hearth:summary=Fetch the public Tor relay list and render it for the tor_nodes nft set.
#
# Downloads the current list of public Tor relays and writes:
#   1. $TOR_NODES_FILE  - plain IPv4 list, one per line (audit trail, diffable)
#   2. $TOR_NFT_FILE    - an `nft -f` snippet that flushes and refills the
#                         `tor_nodes` set in table `inet kids`
# It NEVER loads anything into a live ruleset itself. The gateway reconciler
# (or a deploy step / timer owned by kidnet) applies the snippet with
# `nft -f`, inside the container namespace, the same way everything else is
# applied. One writer, no surprises.
#
# Why ALL relays and not just exits: a kid's Tor client dials a GUARD (entry)
# relay, never an exit. The official torbulkexitlist is exits only, which is
# the right list for a web SERVER refusing Tor visitors and the wrong list
# for a gateway stopping outbound Tor. So we take the full relay list.
#
# Sources, in order:
#   primary : Onionoo, the Tor Project's own directory API (JSON, all running
#             relays, first-party truth): https://onionoo.torproject.org
#   fallback: dan.me.uk full node list (third party, aggregates the same
#             consensus; rate limited to one fetch per 30 minutes, so we only
#             touch it when Onionoo is down and never in a retry loop).
# If both fail, the previous good files are LEFT IN PLACE and we exit
# non-zero: a stale list beats an empty one.
#
# ---------------------------------------------------------------------------
# HONEST LIMITS (read before trusting this layer)
#
# This blocks DEFAULT Tor: a stock Tor Browser download dialling public
# relays. That is the version a curious kid actually installs, so it is
# worth doing. It does NOT and CANNOT block:
#   - BRIDGES: unlisted relays handed out a few at a time exactly so that
#     IP blocklists like this one miss them.
#   - PLUGGABLE TRANSPORTS: obfs4 (traffic looks like random noise),
#     Snowflake (looks like a WebRTC video call via volunteer browsers),
#     meek (rides big CDNs) and WebTunnel (looks like ordinary HTTPS to a
#     real website). These exist to defeat national censorship; a home
#     gateway will not beat them with IP lists.
# So: this layer raises the bar and stops the casual path. The REAL defence
# is the detection half (flag_domains alerts on Tor/bridge lookups, the
# tor_dev attempt counters) plus a parent who talks. A kid reaching for
# bridges has told you something important; that conversation is the control.
# See docs/tor-and-safety.md.
# ---------------------------------------------------------------------------
set -euo pipefail

: "${TOR_NODES_FILE:=/var/lib/hearth/tor-nodes.txt}"
: "${TOR_NFT_FILE:=/var/lib/hearth/tor-nodes.nft}"
: "${TOR_MIN_NODES:=1000}"     # consensus is ~7-8k relays; under this = bad fetch
: "${TOR_CHUNK:=500}"          # elements per `add element` line, for readability
ONIONOO_URL="https://onionoo.torproject.org/details?type=relay&running=true&fields=or_addresses"
DANME_URL="https://www.dan.me.uk/torlist/"   # FULL list (not ?exit), one IP per line

IPV4_RE='^([0-9]{1,3}\.){3}[0-9]{1,3}$'

fetch_onionoo(){
  # JSON -> one IPv4 per line. or_addresses entries look like "1.2.3.4:9001"
  # or "[2001:db8::1]:9001"; the island is IPv4-only (kids.nft drops forwarded
  # v6), so we keep v4 only.
  curl -fsS --max-time 90 --retry 2 --retry-delay 5 "$ONIONOO_URL" | python3 -c '
import json,sys
d=json.load(sys.stdin)
ips=set()
for r in d.get("relays",[]):
    for a in r.get("or_addresses",[]):
        if a.startswith("["):            # IPv6, island is v4-only
            continue
        ip=a.rsplit(":",1)[0]
        parts=ip.split(".")
        if len(parts)==4 and all(p.isdigit() and int(p)<256 for p in parts):
            ips.add(ip)
for ip in sorted(ips, key=lambda i:[int(o) for o in i.split(".")]):
    print(ip)
'
}

fetch_danme(){
  # Plain text, one IP per line, v4 and v6 mixed; keep v4. Rate limited to
  # one hit per 30 minutes per source IP: called once, never retried.
  curl -fsS --max-time 90 "$DANME_URL" | grep -E "$IPV4_RE" | sort -t. -k1,1n -k2,2n -k3,3n -k4,4n -u
}

render_nft(){
  # stdin: one IPv4 per line. stdout: an nft -f snippet. Assumes kids.nft
  # already DECLARES `set tor_nodes` in table inet kids (see
  # docs/tor-and-safety.md for the declaration and the rules that use it).
  local file="${1:-stdin}"
  echo "#!/usr/sbin/nft -f"
  echo "# Generated by kidnet-tor-sync $(date -u +%Y-%m-%dT%H:%M:%SZ); do not edit."
  echo "# Apply inside the gateway namespace: nft -f <this file>"
  echo "flush set inet kids tor_nodes"
  awk -v chunk="$TOR_CHUNK" '
    { ips[NR]=$1 }
    END {
      for (i=1; i<=NR; i+=chunk) {
        line="add element inet kids tor_nodes { "
        for (j=i; j<i+chunk && j<=NR; j++) line=line ips[j] ((j<i+chunk-1 && j<NR) ? ", " : "")
        print line " }"
      }
    }'
}

sync(){
  local dir tmp n src="onionoo"
  dir=$(dirname "$TOR_NODES_FILE"); mkdir -p "$dir"
  tmp=$(mktemp "$dir/.tor-nodes.XXXXXX")
  trap 'rm -f "$tmp"' EXIT

  if ! fetch_onionoo >"$tmp" 2>/dev/null || [ ! -s "$tmp" ]; then
    echo "kidnet-tor-sync: onionoo unreachable, trying dan.me.uk fallback" >&2
    src="dan.me.uk"
    fetch_danme >"$tmp" || true
  fi

  n=$(grep -cE "$IPV4_RE" "$tmp" || true)
  if [ "$n" -lt "$TOR_MIN_NODES" ]; then
    echo "kidnet-tor-sync: FAILED: got $n addresses (< $TOR_MIN_NODES) from $src;" >&2
    echo "kidnet-tor-sync: keeping previous list at $TOR_NODES_FILE untouched" >&2
    exit 1
  fi

  # Belt and braces: only well-formed v4 lines make it into the output.
  grep -E "$IPV4_RE" "$tmp" > "$tmp.clean" && mv "$tmp.clean" "$tmp"

  mv "$tmp" "$TOR_NODES_FILE"; trap - EXIT
  render_nft < "$TOR_NODES_FILE" > "$TOR_NFT_FILE.tmp"
  mv "$TOR_NFT_FILE.tmp" "$TOR_NFT_FILE"
  echo "kidnet-tor-sync: $n Tor relay addresses from $src"
  echo "kidnet-tor-sync: list    -> $TOR_NODES_FILE"
  echo "kidnet-tor-sync: snippet -> $TOR_NFT_FILE (apply with: nft -f, in the gateway netns)"
}

emit(){
  # Print ready-to-run nft commands from the CURRENT file, without fetching.
  # For the operator or the reconciler; still never executed from here.
  [ -s "$TOR_NODES_FILE" ] || { echo "kidnet-tor-sync: no list at $TOR_NODES_FILE (run sync first)" >&2; exit 1; }
  echo "nft flush set inet kids tor_nodes"
  awk -v chunk="$TOR_CHUNK" '
    { ips[NR]=$1 }
    END {
      for (i=1; i<=NR; i+=chunk) {
        line="nft add element inet kids tor_nodes \x27{ "
        for (j=i; j<i+chunk && j<=NR; j++) line=line ips[j] ((j<i+chunk-1 && j<NR) ? ", " : "")
        print line " }\x27"
      }
    }' "$TOR_NODES_FILE"
}

status(){
  if [ -s "$TOR_NODES_FILE" ]; then
    echo "list:    $TOR_NODES_FILE  ($(wc -l < "$TOR_NODES_FILE") addresses, fetched $(date -r "$TOR_NODES_FILE" '+%Y-%m-%d %H:%M'))"
  else
    echo "list:    MISSING ($TOR_NODES_FILE); run: kidnet-tor-sync sync"
  fi
  if [ -s "$TOR_NFT_FILE" ]; then
    echo "snippet: $TOR_NFT_FILE"
  else
    echo "snippet: MISSING ($TOR_NFT_FILE)"
  fi
}

case "${1:-sync}" in
  sync)   sync;;
  emit)   emit;;
  status) status;;
  *) echo "usage: kidnet-tor-sync [sync|emit|status]"; echo "  sync    fetch relay list, write $TOR_NODES_FILE + nft snippet (default)"; echo "  emit    print nft add-element commands from the current list"; echo "  status  show list age and size"; exit 1;;
esac
