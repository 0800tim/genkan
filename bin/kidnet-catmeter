#!/usr/bin/env bash
# hearth:summary=Meter active minutes per category (gaming, video, download) and enforce budgets.
#
# Runs every minute. Reconciles the category IP sets from category_ips (learned
# from DNS answers), reads and RESETS the per-device byte counters, and for any
# device that pulled more than a small threshold this minute counts one active
# minute for that child + category. When a child hits their category budget,
# that category is blocked (DNS via kidnet-adguard, plus the category set), and
# music/schoolwork are never touched. See METERING.md.
#
# DOWNLOADS ARE NOT SCREEN TIME. A game update is bandwidth, not play, and
# charging it to a child's gaming budget would be a lie. Two things separate
# them, and both are needed:
#
#   1. Destination. The content-delivery names (steamcontent.com,
#      cs.steampowered.com, the PSN/Xbox/Nintendo asset CDNs, OS and app store
#      updates) are their own 'download' category in category_domains, and are
#      longer suffixes than the gaming domains they sit under, so they win.
#   2. Rate. A game is a trickle and an update is a flood, so anything above
#      DOWNLOAD_BYTES_PER_MIN to a GAMING address inside one minute is booked
#      as a download instead. This catches the CDN names nobody has listed yet.
#      Deliberately not applied to video: 4K streaming is legitimately fast.
#
# Download minutes are recorded (so the week's report and the live chart can
# show them) but never given a budget, so they cannot cut a child off.
set -euo pipefail
GW="${GW_CONTAINER:-hearth-gw}"
# nft access: container by default; NFT_NS=<netns> for tests, NFT_DIRECT=1 for host.
nftx(){ if [ -n "${NFT_NS:-}" ]; then sudo ip netns exec "$NFT_NS" nft "$@"
        elif [ "${NFT_DIRECT:-0}" = 1 ]; then nft "$@"
        else docker exec -i "$GW" nft "$@"; fi; }
psqll(){ docker exec -i postgres psql -U postgres -d kids_network -tAc "$1"; }
# Bytes/minute that count as "actively using" (not idle keepalive).
: "${GAMING_THRESH:=51200}"   # ~50 KB/min
: "${VIDEO_THRESH:=256000}"   # ~250 KB/min, video is high bitrate
: "${DOWNLOAD_THRESH:=256000}"
# ~50 MB inside one minute (about 7 Mbit/s sustained). Above this on a gaming
# address it is content delivery, not play. Gameplay rarely passes 1 Mbit/s.
: "${DOWNLOAD_BYTES_PER_MIN:=52428800}"

nftx list set inet kids gaming_ips >/dev/null 2>&1 || { echo "kidnet-catmeter: firewall/sets not loaded"; exit 0; }

# 0. The download sets and their counting rule. config/nftables/kids.nft ships
#    them, so on a fresh gateway this is a no-op; it exists so an already
#    running island picks the new category up on the next tick instead of
#    needing the container restarted. Only ever ADDS what is genuinely absent,
#    so it can never stack a duplicate rule.
if ! nftx list set inet kids download_ips >/dev/null 2>&1; then
  printf 'table inet kids {\n  set download_ips { type ipv4_addr; flags interval; }\n  set download_dev { type ipv4_addr; flags dynamic; counter; }\n}\n' \
    | nftx -f - 2>/dev/null || true
fi
if ! nftx list chain inet kids metering 2>/dev/null | grep -q '@download_ips'; then
  nftx add rule inet kids metering iifname "${KIDS_IFACE:-kids0}" ip daddr @download_ips \
       update @download_dev "{" ip saddr "}" 2>/dev/null || true
fi

# 1. Reconcile the category IP sets to exactly what we have learned (last 24h
#    of answers). Flush-then-fill in ONE transaction, not add-only: an address
#    that turned out to be a shared CDN front door and was withdrawn from
#    category_ips has to leave the firewall too, or it keeps mis-colouring
#    every byte sent to it until the container is restarted.
if [ "$(psqll "SELECT 1" 2>/dev/null)" = 1 ]; then
  for cat in gaming video download; do
    nftx list set inet kids "${cat}_ips" >/dev/null 2>&1 || continue
    ips=$(psqll "SELECT host(ip) FROM category_ips WHERE category='$cat' AND seen > now() - interval '24 hours'" | grep -E '^[0-9]' | paste -sd, || true)
    { echo "flush set inet kids ${cat}_ips"
      [ -n "$ips" ] && echo "add element inet kids ${cat}_ips { $ips }"
      true; } | nftx -f - 2>/dev/null || true
  done
else
  echo "kidnet-catmeter: database unreachable, keeping the existing address sets"
fi

# 2. Read + reset the per-device counters (reset => this read is the minute's delta).
#    Emits "<device ip> <bytes>" for every device that moved anything.
bytes_from_set(){ # <setname>
  local set="$1" json
  json=$(nftx -j list set inet kids "$set" 2>/dev/null) || return 0
  echo "$json" | SETN="$set" python3 -c "
import sys,json,os
setn=os.environ['SETN']
try: d=json.load(sys.stdin)
except Exception: sys.exit(0)
for blk in d.get('nftables',[]):
    s=blk.get('set')
    if not s or s.get('name')!=setn: continue
    for e in s.get('elem',[]) or []:
        el=e.get('elem') if isinstance(e,dict) and 'elem' in e else e
        if not isinstance(el,dict): continue
        ip=el.get('val'); b=(el.get('counter') or {}).get('bytes',0)
        if isinstance(ip,str) and b>0: print(ip,b)
"
}
count_minute(){ # <child id> <category>
  psqll "INSERT INTO category_usage(child_id,day,category,used_min) VALUES($1,CURRENT_DATE,'$2',1)
         ON CONFLICT (child_id,day,category) DO UPDATE SET used_min=category_usage.used_min+1" >/dev/null
}
declare -A active=()
for pair in "gaming $GAMING_THRESH gaming_dev" "video $VIDEO_THRESH video_dev" "download $DOWNLOAD_THRESH download_dev"; do
  set -- $pair; cat="$1"; thresh="$2"; setn="$3"
  nftx list set inet kids "$setn" >/dev/null 2>&1 || continue
  while read -r ip bytes; do
    [ -n "${ip:-}" ] || continue
    [ "$bytes" -ge "$thresh" ] || continue
    # The rate rule: a flood on a gaming address is an update, not a game.
    book="$cat"
    if [ "$cat" = gaming ] && [ "$bytes" -ge "$DOWNLOAD_BYTES_PER_MIN" ]; then book=download; fi
    # attribute to the child owning this reserved IP
    cid=$(psqll "SELECT child_id FROM devices WHERE host(reserved_ip)='$ip' AND is_active LIMIT 1")
    [ -n "$cid" ] || continue
    count_minute "$cid" "$book"
    active["$cid:$book"]=1
  done < <(bytes_from_set "$setn")
  nftx flush set inet kids "$setn" 2>/dev/null || true   # reset for next minute
done

# 3. Enforce budgets: any child over their category budget gets that category
#    blocked. 'download' is excluded on purpose: bandwidth is not screen time,
#    so it is measured and shown but never charged and never enforced.
enforce=0
while IFS='|' read -r cid cat used budget; do
  [ -n "$cid" ] || continue
  if [ "$used" -ge "$budget" ]; then
    already=$(psqll "SELECT blocked FROM category_state WHERE child_id=$cid AND category='$cat'")
    if [ "$already" != "t" ]; then
      psqll "INSERT INTO category_state(child_id,category,blocked,set_by) VALUES($cid,'$cat',true,'over-budget')
             ON CONFLICT (child_id,category) DO UPDATE SET blocked=true, since=now(), set_by='over-budget'" >/dev/null
      name=$(psqll "SELECT name FROM children WHERE id=$cid")
      echo "kidnet-catmeter: $name hit their $cat budget ($used/$budget min); blocking $cat"
      enforce=1
    fi
  fi
done < <(psqll "SELECT u.child_id||'|'||u.category||'|'||u.used_min||'|'||b.daily_min
  FROM category_usage u JOIN category_budgets b ON b.child_id=u.child_id AND b.category=u.category
  WHERE u.day=CURRENT_DATE AND u.category <> 'download'")

# Push any new category blocks to the DNS layer.
[ "$enforce" = 1 ] && [ -n "${ADGUARD_PASS:-}" ] && { d="$(dirname "$0")/kidnet-adguard"; [ -x "$d" ] && "$d" apply >/dev/null 2>&1 || true; }
n_active=${#active[@]}
echo "kidnet-catmeter: tick done ($n_active active child/category this minute)"
