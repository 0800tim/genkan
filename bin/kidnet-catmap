#!/usr/bin/env bash
# hearth:summary=Learn which IPs belong to which category from AdGuard answers.
#
# The trick that makes per-category metering possible without decrypting
# traffic: clawdia is the DNS server, so when a device resolves a gaming or
# video domain we learn the IPs it will talk to, and tag those IPs by category
# (category_ips). The firewall then meters bytes per category by destination
# IP. Runs on a short timer. See METERING.md.
set -euo pipefail
: "${ADGUARD_URL:=http://127.0.0.1:8853}" "${ADGUARD_USER:=admin}" "${ADGUARD_PASS:?set ADGUARD_PASS}"
PAGES="${CATMAP_PAGES:-15}"
DB=(docker exec -i postgres psql -U postgres -d kids_network)

# domain -> category, longest-suffix match. Pulled once from the DB.
MAP=$("${DB[@]}" -tAc "SELECT category||' '||domain FROM category_domains WHERE category IN ('gaming','video','social','audio')")

TSV=$(ADGUARD_URL="$ADGUARD_URL" ADGUARD_USER="$ADGUARD_USER" ADGUARD_PASS="$ADGUARD_PASS" PAGES="$PAGES" MAP="$MAP" python3 <<'PY'
import os,json,urllib.request,urllib.parse,base64,sys,csv
url=os.environ["ADGUARD_URL"]; pages=int(os.environ["PAGES"])
auth=base64.b64encode(f'{os.environ["ADGUARD_USER"]}:{os.environ["ADGUARD_PASS"]}'.encode()).decode()
# build domain->category (suffix match on registrable-ish domain)
cat_of={}
for line in os.environ["MAP"].splitlines():
    if not line.strip(): continue
    c,d=line.split(" ",1); cat_of[d.strip().lower()]=c
def category(name):
    name=name.rstrip(".").lower(); parts=name.split(".")
    for i in range(len(parts)):
        suf=".".join(parts[i:])
        if suf in cat_of: return cat_of[suf]
    return None
def get(u):
    r=urllib.request.Request(u); r.add_header("Authorization","Basic "+auth)
    return json.load(urllib.request.urlopen(r,timeout=10))
seen=set(); rows=[]; older=None
for _ in range(pages):
    u=url+"/control/querylog?limit=100"+(f"&older_than={urllib.parse.quote(older)}" if older else "")
    d=get(u); data=d.get("data") or []
    if not data: break
    for e in data:
        name=(e.get("question") or {}).get("name","")
        cat=category(name)
        if not cat: continue
        for a in (e.get("answer") or []):
            if a.get("type")=="A":
                ip=a.get("value","")
                if ip and (ip,cat) not in seen:
                    seen.add((ip,cat)); rows.append((ip,cat))
    older=d.get("oldest") or (data[-1].get("time") if data else None)
    if not older: break
w=csv.writer(sys.stdout,delimiter="\t")
for ip,cat in rows: w.writerow([ip,cat])
PY
)
[ -z "$TSV" ] && { echo "kidnet-catmap: nothing new"; exit 0; }
printf '%s\n' "$TSV" | "${DB[@]}" -qc "
CREATE TEMP TABLE _ci(ip inet, category text);
COPY _ci FROM STDIN WITH (FORMAT text);
INSERT INTO category_ips(ip,category,seen)
SELECT ip,category,now() FROM _ci
ON CONFLICT (ip,category) DO UPDATE SET seen=now();"
N=$(printf '%s\n' "$TSV" | grep -c . || true)
echo "kidnet-catmap: tagged $N ip/category pair(s)"
