# Copy to secrets.env (gitignored) and set your own values.
# KIDS_DB_URL is used by host-side tools (dashboard, kidnet) and points at
# Postgres as the host sees it. KIDS_DB_URL_DOCKER is the same database as
# containers see it (the postgres container's network alias).
KIDS_DB_URL=postgres://kids_app:CHANGE_ME@127.0.0.1:5432/kids_network
KIDS_DB_URL_DOCKER=postgres://kids_app:CHANGE_ME@postgres:5432/kids_network
# Optional, and the only key that ever leaves the house. Set it, restart the
# dashboard, and the child page's "Summary written by an AI" card can be
# switched on. Leave it unset and that card sends nothing and says so.
# GENKAN_AI_SUMMARY_KEY=sk-ant-...
