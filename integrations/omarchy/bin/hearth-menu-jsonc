#!/bin/bash

# omarchy:summary=Generate the Hearth entries for the Omarchy menu extension
# omarchy:args=[--install] [--file <path>] [kid...]
# omarchy:examples=hearth-menu-jsonc | hearth-menu-jsonc --install | hearth-menu-jsonc Ada Ben

# Prints a block of JSONC entries for ~/.config/omarchy/extensions/omarchy-menu.jsonc.
# With --install it writes that block into the file itself, between markers, so
# running it again replaces the block and never touches anything else the user
# has put in there.
#
# Menu ids are dotted: "hearth.kid-ada.off" is a row inside the "hearth.kid-ada"
# submenu, which is itself inside "hearth". That is how Omarchy infers the tree,
# so there is no parent field to keep in sync.

set -euo pipefail

readonly conf_file="${HEARTH_CONF:-${XDG_CONFIG_HOME:-$HOME/.config}/hearth/omarchy.conf}"
if [[ -r $conf_file ]]; then
  # shellcheck disable=SC1090
  source "$conf_file"
fi

readonly bin_dir="${HEARTH_BIN:-$(dirname "$(readlink -f "$0")")}"
readonly begin_mark="// >>> hearth: generated by hearth-menu-jsonc, do not edit inside >>>"
readonly end_mark="// <<< hearth <<<"

menu_file="${HEARTH_MENU_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/extensions/omarchy-menu.jsonc}"
install=0
kids=()

fail() {
  echo "${0##*/}: $*" >&2
  exit 1
}

while (($# > 0)); do
  case "$1" in
    --install)
      install=1
      shift
      ;;
    --file)
      menu_file="${2:-}"
      [[ -n $menu_file ]] || fail "--file needs a path"
      shift 2
      ;;
    -h | --help)
      echo "Usage: hearth-menu-jsonc [--install] [--file <path>] [kid...]"
      exit 0
      ;;
    -*)
      fail "unknown option: $1"
      ;;
    *)
      kids+=("$1")
      shift
      ;;
  esac
done

command -v jq >/dev/null 2>&1 || fail "jq is required"

# No kids on the command line: ask the gateway. If it cannot answer we still
# produce a working menu, it just asks who each action is for.
if ((${#kids[@]} == 0)); then
  mapfile -t kids < <("$bin_dir/hearth-kidnet" --kids 2>/dev/null || true)
fi

# kidnet's own gate on a person's name. Anything else is dropped rather than
# quoted, because these names end up inside a shell command in the menu file.
valid_kids=()
for kid in "${kids[@]:-}"; do
  [[ $kid =~ ^[A-Za-z0-9_-]{1,32}$ ]] && valid_kids+=("$kid")
done

# The block itself. Icons are Nerd Font glyphs in the FontAwesome range, which
# every Nerd Font carries.
generate() {
  jq -r -n --arg bin "$bin_dir/hearth-action" --args '
    def rows: [
      { id: "hearth",
        v: { icon: "", label: "Hearth", description: "The kids\u0027 internet" } },
      { id: "hearth.dinner",
        v: { icon: "", label: "Dinner", description: "Pause every kid at once",
             action: "\($bin) run dinner" } },
      { id: "hearth.resume",
        v: { icon: "", label: "Resume all", description: "Give everyone their internet back",
             action: "\($bin) run resume" } }
    ];

    def per_kid($kid):
      ($kid | ascii_downcase | gsub("[^a-z0-9]+"; "-")) as $slug |
      "hearth.kid-\($slug)" as $p |
      [
        { id: $p,          v: { icon: "", label: $kid, title: "\($kid)\u0027s internet" } },
        { id: "\($p).off", v: { icon: "", label: "Internet off", action: "\($bin) run off \($kid)" } },
        { id: "\($p).on",  v: { icon: "", label: "Internet on",  action: "\($bin) run on \($kid)" } },
        { id: "\($p).game-off",  v: { icon: "", label: "Kill gaming",     action: "\($bin) run game off \($kid)" } },
        { id: "\($p).game-on",   v: { icon: "", label: "Gaming back on",  action: "\($bin) run game on \($kid)" } },
        { id: "\($p).study-on",  v: { icon: "", label: "Study mode on",   description: "Gaming and video off, schoolwork and audio stay", action: "\($bin) run study on \($kid)" } },
        { id: "\($p).study-off", v: { icon: "", label: "Study mode off",  action: "\($bin) run study off \($kid)" } },
        { id: "\($p).bonus-15",  v: { icon: "", label: "Grant 15 minutes", action: "\($bin) run bonus \($kid) 15 menu" } },
        { id: "\($p).bonus-30",  v: { icon: "", label: "Grant 30 minutes", action: "\($bin) run bonus \($kid) 30 menu" } },
        { id: "\($p).time",      v: { icon: "", label: "How much time is left", action: "\($bin) run time \($kid)" } }
      ];

    def pickers: [
      { id: "hearth.off",      v: { icon: "", label: "Internet off",     action: "\($bin) pick \"Internet off\" off KID" } },
      { id: "hearth.on",       v: { icon: "", label: "Internet on",      action: "\($bin) pick \"Internet on\" on KID" } },
      { id: "hearth.game-off", v: { icon: "", label: "Kill gaming",      action: "\($bin) pick \"Kill gaming\" game off KID" } },
      { id: "hearth.study-on", v: { icon: "", label: "Study mode on",    action: "\($bin) pick \"Study mode\" study on KID" } },
      { id: "hearth.bonus-15", v: { icon: "", label: "Grant 15 minutes", action: "\($bin) pick \"Grant 15 minutes\" bonus KID 15 menu" } },
      { id: "hearth.bonus-30", v: { icon: "", label: "Grant 30 minutes", action: "\($bin) pick \"Grant 30 minutes\" bonus KID 30 menu" } }
    ];

    def tail: [
      { id: "hearth.status",
        v: { icon: "", label: "What is happening now", action: "\($bin) status" } },
      { id: "hearth.dashboard",
        v: { icon: "", label: "Open dashboard", action: "\($bin) dashboard" } },
      { id: "hearth.refresh",
        v: { icon: "", label: "Refresh the kid list", description: "Rebuild these entries from the gateway", action: "\($bin) menu" } }
    ];

    ($ARGS.positional | map(select(test("^[A-Za-z0-9_-]+$"))) | map(per_kid(.)) | add // []) as $kidrows |
    (rows + (if ($kidrows | length) > 0 then $kidrows else pickers end) + tail)
    | .[]
    | "  \(.id | tojson): \(.v | tojson),"
  ' "${valid_kids[@]:-}"
}

block_file=$(mktemp)
trap 'rm -f "$block_file" "${block_file}.new"' EXIT
{
  printf '  %s\n' "$begin_mark"
  generate
  printf '  %s\n' "$end_mark"
} >"$block_file"

if ((install == 0)); then
  cat "$block_file"
  exit 0
fi

mkdir -p "$(dirname "$menu_file")"
if [[ ! -f $menu_file ]]; then
  printf '{\n}\n' >"$menu_file"
fi

# Replace the block if the markers are there, otherwise slide it in above the
# file's closing brace. Whole-line comments are all the Omarchy parser strips,
# which is exactly what the markers are.
if grep -qF "$begin_mark" "$menu_file"; then
  awk -v b="$begin_mark" -v e="$end_mark" -v bf="$block_file" '
    index($0, b) { while ((getline line < bf) > 0) print line; close(bf); skip = 1; next }
    skip && index($0, e) { skip = 0; next }
    skip { next }
    { print }
  ' "$menu_file" >"${block_file}.new"
else
  close_line=$(grep -n '^[[:space:]]*}[[:space:]]*$' "$menu_file" | tail -1 | cut -d: -f1)
  if [[ -n $close_line ]]; then
    awk -v n="$close_line" -v bf="$block_file" '
      NR == n { while ((getline line < bf) > 0) print line; close(bf) }
      { print }
    ' "$menu_file" >"${block_file}.new"
  else
    # A file with no closing brace of its own (an empty or one-line file).
    { printf '{\n'; cat "$block_file"; printf '}\n'; } >"${block_file}.new"
  fi
fi

# Never leave a file the menu parser will reject: a broken extension silently
# drops every user entry, which would look like Omarchy losing their menu.
if ! "$bin_dir/hearth-jsonc-check" "${block_file}.new"; then
  fail "the result would not parse as JSONC, leaving $menu_file alone"
fi

if cmp -s "${block_file}.new" "$menu_file"; then
  echo "Hearth menu entries already up to date in $menu_file"
else
  cp -p "$menu_file" "${menu_file}.hearth-backup-$(date +%Y%m%d%H%M%S)"
  cat "${block_file}.new" >"$menu_file"
  echo "Wrote Hearth menu entries to $menu_file"
fi

omarchy-menu refresh >/dev/null 2>&1 || true
