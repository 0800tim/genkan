#!/bin/bash

# omarchy:summary=Run one kidnet command against the Hearth gateway (local, ssh or http)
# omarchy:args=[--kids|--alerts|--mode] <kidnet args...>
# omarchy:examples=hearth-kidnet status | hearth-kidnet game off Ada | hearth-kidnet --kids

# The one place that knows WHERE the gateway is. Everything else in this
# integration shells out to here, so the desktop scripts never care whether
# kidnet is on this machine, on the other end of an ssh hop, or only reachable
# through the dashboard's HTTP API.
#
# Modes:
#   local  run kidnet on this machine (the default when kidnet is on PATH)
#   ssh    run kidnet on the gateway over ssh, with a multiplexed connection
#   http   POST to the dashboard's /api/act with DASH_TOKEN
#
# Output is always kidnet's own plain text, on stdout, whichever mode ran.

set -euo pipefail

readonly conf_file="${HEARTH_CONF:-${XDG_CONFIG_HOME:-$HOME/.config}/hearth/omarchy.conf}"
if [[ -r $conf_file ]]; then
  # shellcheck disable=SC1090
  source "$conf_file"
fi

: "${HEARTH_MODE:=auto}"
: "${HEARTH_KIDNET:=kidnet}"
: "${HEARTH_SSH:=}"
: "${HEARTH_SSH_OPTS:=-o BatchMode=yes -o ConnectTimeout=4 -o ControlMaster=auto -o ControlPath=${XDG_RUNTIME_DIR:-/tmp}/hearth-ssh-%h-%p-%r -o ControlPersist=120}"
: "${HEARTH_URL:=}"
: "${HEARTH_DASH_TOKEN:=}"
: "${HEARTH_TIMEOUT:=8}"
: "${HEARTH_KIDS:=}"
: "${HEARTH_ALERTS:=1}"
# Read only, and as the restricted kids_agent role rather than the superuser:
# see config/db/grants.sql in the Hearth repo for what that role may touch.
: "${HEARTH_PSQL:=docker exec -i postgres psql -U kids_agent -d kids_network -tAc}"

fail() {
  echo "${0##*/}: $*" >&2
  exit 1
}

resolve_mode() {
  case "$HEARTH_MODE" in
    local | ssh | http)
      echo "$HEARTH_MODE"
      ;;
    auto)
      if command -v "$HEARTH_KIDNET" >/dev/null 2>&1; then
        echo local
      elif [[ -n $HEARTH_SSH ]]; then
        echo ssh
      elif [[ -n $HEARTH_URL ]]; then
        echo http
      else
        echo none
      fi
      ;;
    *)
      fail "unknown HEARTH_MODE '$HEARTH_MODE' (local, ssh, http or auto)"
      ;;
  esac
}

run_local() {
  timeout "$HEARTH_TIMEOUT" "$HEARTH_KIDNET" "$@"
}

# ssh joins its arguments with spaces and hands the lot to the remote login
# shell, so quote every word before it leaves this machine.
run_ssh() {
  local remote
  remote=$(printf '%q ' "$HEARTH_KIDNET" "$@")
  # shellcheck disable=SC2086
  timeout "$HEARTH_TIMEOUT" ssh $HEARTH_SSH_OPTS "$HEARTH_SSH" "$remote"
}

# The dashboard's control API takes { cmd, who, arg }, where cmd may be one or
# two words ("off", "game off") and the person goes after any subverb. Its own
# allowlist decides what is permitted, so nothing here can widen it.
run_http() {
  [[ -n $HEARTH_URL ]] || fail "http mode needs HEARTH_URL"
  command -v jq >/dev/null 2>&1 || fail "http mode needs jq"
  command -v curl >/dev/null 2>&1 || fail "http mode needs curl"

  local cmd="${1:-}" who="" payload response
  shift || true
  case "$cmd" in
    game | media | study)
      if [[ ${1:-} == "on" || ${1:-} == "off" ]]; then
        cmd="$cmd $1"
        shift
      fi
      ;;
  esac
  if (($# > 0)); then
    who="$1"
    shift
  fi

  payload=$(jq -nc --arg cmd "$cmd" --arg who "$who" --args '
    { cmd: $cmd, who: $who, arg: $ARGS.positional }' "$@")

  local -a auth=()
  [[ -n $HEARTH_DASH_TOKEN ]] && auth=(-H "x-dash-token: $HEARTH_DASH_TOKEN")

  response=$(curl -sS --max-time "$HEARTH_TIMEOUT" \
    -X POST "${HEARTH_URL%/}/api/act" \
    -H 'content-type: application/json' \
    "${auth[@]}" \
    --data "$payload") || fail "dashboard at $HEARTH_URL did not answer"

  jq -r '.out // ""' <<<"$response"
  [[ $(jq -r '.ok // false' <<<"$response") == true ]]
}

run_kidnet() {
  case "$(resolve_mode)" in
    local) run_local "$@" ;;
    ssh) run_ssh "$@" ;;
    http) run_http "$@" ;;
    none) fail "no gateway configured: set HEARTH_SSH or HEARTH_URL in $conf_file" ;;
  esac
}

# Read-only count of alerts nobody has acknowledged. kidnet has no verb for it,
# so this is the one query that goes straight to Postgres, and it only works
# where the Docker socket is (local and ssh). Anything else answers 0 quietly.
alert_count() {
  [[ $HEARTH_ALERTS == 1 ]] || { echo 0; return 0; }
  local sql="SELECT count(*) FROM alerts WHERE NOT acknowledged" out=""
  case "$(resolve_mode)" in
    local)
      # shellcheck disable=SC2086
      out=$(timeout "$HEARTH_TIMEOUT" $HEARTH_PSQL "$sql" 2>/dev/null) || out=""
      ;;
    ssh)
      # shellcheck disable=SC2086
      out=$(timeout "$HEARTH_TIMEOUT" ssh $HEARTH_SSH_OPTS "$HEARTH_SSH" \
        "$(printf '%q ' $HEARTH_PSQL "$sql")" 2>/dev/null) || out=""
      ;;
  esac
  [[ $out =~ ^[0-9]+$ ]] && echo "$out" || echo 0
}

# Who the bar and the menu should show. An explicit HEARTH_KIDS wins; otherwise
# take every person who owns a device on the roster.
kid_list() {
  if [[ -n $HEARTH_KIDS ]]; then
    # shellcheck disable=SC2086
    printf '%s\n' $HEARTH_KIDS
    return 0
  fi
  run_kidnet devices | awk '
    match($0, /\[[^]]*\]/) {
      person = substr($0, RSTART + 1, RLENGTH - 2)
      if (person != "UNASSIGNED" && person != "") print person
    }' | sort -u
}

case "${1:-}" in
  --kids)
    kid_list
    ;;
  --alerts)
    alert_count
    ;;
  --mode)
    resolve_mode
    ;;
  -h | --help | "")
    cat <<USAGE
Usage: hearth-kidnet [--kids|--alerts|--mode] <kidnet args...>

Runs one kidnet command against the Hearth gateway and prints its output.

  --kids     list the people the bar and menu should offer
  --alerts   count alerts nobody has acknowledged (local and ssh only)
  --mode     print the transport that would be used

Configuration lives in $conf_file.
USAGE
    ;;
  *)
    run_kidnet "$@"
    ;;
esac
