#!/bin/bash

# omarchy:summary=Run a Genkan action from the Omarchy menu or the status bar
# omarchy:args=run <kidnet args...> | pick <prompt> <kidnet args with KID> | status | dashboard | menu
# omarchy:examples=genkan-action run dinner | genkan-action pick "Internet off" off KID | genkan-action dashboard

# Every menu row and every bar click lands here. It runs one kidnet command
# through genkan-kidnet, then says what happened in a desktop notification, so
# the parent gets feedback without opening a terminal.

set -euo pipefail

readonly conf_file="${GENKAN_CONF:-${XDG_CONFIG_HOME:-$HOME/.config}/genkan/omarchy.conf}"
if [[ -r $conf_file ]]; then
  # shellcheck disable=SC1090
  source "$conf_file"
fi

: "${GENKAN_URL:=}"
: "${GENKAN_DASHBOARD_URL:=$GENKAN_URL}"

readonly bin_dir="${GENKAN_BIN:-$(dirname "$(readlink -f "$0")")}"
readonly kidnet_cmd="$bin_dir/genkan-kidnet"

fail() {
  echo "${0##*/}: $*" >&2
  exit 1
}

kidnet() {
  if [[ -x $kidnet_cmd ]]; then
    "$kidnet_cmd" "$@"
  else
    genkan-kidnet "$@"
  fi
}

# Omarchy's own notifier when it is there, the freedesktop one otherwise, and
# silence when neither is. A menu action must never fail because of feedback.
notify() {
  local headline="$1" body="${2:-}" urgency="${3:-low}"
  if command -v omarchy-notification-send >/dev/null 2>&1; then
    omarchy-notification-send --app-name Genkan -u "$urgency" "$headline" "$body" >/dev/null 2>&1 || true
  elif command -v notify-send >/dev/null 2>&1; then
    notify-send -a Genkan -u "$urgency" "$headline" "$body" >/dev/null 2>&1 || true
  fi
}

# Ask which child. Omarchy's own menu is the picker when the shell is running,
# and the usual dmenu-alikes cover every other desktop.
choose_kid() {
  local prompt="$1"
  local -a kids=()
  mapfile -t kids < <(kidnet --kids 2>/dev/null) || true
  ((${#kids[@]} > 0)) || fail "no kids to choose from"

  # Fed from a here-string rather than a pipe: a picker that stops reading
  # after the first line would otherwise SIGPIPE the writer and, with
  # pipefail on, look exactly like the parent cancelling.
  local list
  list=$(printf '%s\n' "${kids[@]}")

  if command -v omarchy-menu-select >/dev/null 2>&1; then
    omarchy-menu-select "$prompt" "${kids[@]}"
  elif command -v walker >/dev/null 2>&1; then
    walker --dmenu --placeholder "$prompt" <<<"$list"
  elif command -v fuzzel >/dev/null 2>&1; then
    fuzzel --dmenu --prompt "$prompt: " <<<"$list"
  elif command -v wofi >/dev/null 2>&1; then
    wofi --dmenu --prompt "$prompt" <<<"$list"
  elif command -v rofi >/dev/null 2>&1; then
    rofi -dmenu -p "$prompt" <<<"$list"
  else
    fail "no picker available (omarchy-menu-select, walker, fuzzel, wofi or rofi)"
  fi
}

run_action() {
  local out status=0
  out=$(kidnet "$@" 2>&1) || status=$?
  if ((status == 0)); then
    notify "Genkan" "${out:-$*}"
  else
    notify "Genkan could not do that" "${out:-$*}" normal
  fi
  printf '%s\n' "$out"
  return "$status"
}

open_url() {
  local url="$1"
  if command -v omarchy-launch-webapp >/dev/null 2>&1; then
    omarchy-launch-webapp "$url"
  elif command -v xdg-open >/dev/null 2>&1; then
    setsid xdg-open "$url" >/dev/null 2>&1 &
  else
    fail "no way to open a browser"
  fi
}

case "${1:-}" in
  run)
    shift
    (($# > 0)) || fail "run needs a kidnet command"
    run_action "$@"
    ;;

  # "pick <prompt> <args...>": the literal word KID in the args is replaced by
  # whoever the parent chooses, so one script covers every per-kid action.
  pick)
    shift
    (($# > 1)) || fail "pick needs a prompt and a kidnet command"
    prompt="$1"
    shift
    kid=$(choose_kid "$prompt") || exit 0 # cancelled is not an error
    [[ -n $kid ]] || exit 0
    args=()
    for arg in "$@"; do
      [[ $arg == KID ]] && args+=("$kid") || args+=("$arg")
    done
    run_action "${args[@]}"
    ;;

  status)
    body=$(kidnet status 2>&1) || body=""
    [[ -n ${body//[[:space:]]/} ]] || body="Nothing is blocked."
    while read -r kid; do
      [[ -n $kid ]] || continue
      line=$(kidnet time "$kid" 2>/dev/null) || continue
      body="$body"$'\n'"$line"
    done < <(kidnet --kids 2>/dev/null)
    notify "Genkan right now" "$body"
    printf '%s\n' "$body"
    ;;

  dashboard)
    [[ -n $GENKAN_DASHBOARD_URL ]] ||
      fail "set GENKAN_DASHBOARD_URL (or GENKAN_URL) in $conf_file"
    open_url "$GENKAN_DASHBOARD_URL"
    ;;

  menu)
    # Rebuild the menu entries against the current kid list, then reload it.
    "$bin_dir/genkan-menu-jsonc" --install >/dev/null &&
      notify "Genkan" "Menu rebuilt from the current kid list" ||
      notify "Genkan" "Could not rebuild the menu" normal
    ;;

  -h | --help | "")
    cat <<USAGE
Usage: genkan-action <command>

  run <kidnet args...>            run a kidnet command and notify the result
  pick <prompt> <args with KID>   ask which child first, then run it
  status                          notify what is blocked and who has time left
  dashboard                       open the Genkan dashboard in a browser
  menu                            rebuild the Omarchy menu from the kid list

Configuration lives in $conf_file.
USAGE
    ;;

  *)
    fail "unknown command '$1'. Try 'genkan-action --help'."
    ;;
esac
