// A sample of what hearth-menu-jsonc generates for a house with three
// kids. install.sh writes the real thing (with your kids, and with the
// real path to hearth-action) into
//   ~/.config/omarchy/extensions/omarchy-menu.jsonc
// between the marker comments, so your own entries there are untouched.
//
// When the gateway cannot be reached at install time, the per-kid
// submenus are replaced by six rows that ask which child first.
{
  // >>> hearth: generated by hearth-menu-jsonc, do not edit inside >>>
  "hearth": {"icon":"","label":"Hearth","description":"The kids' internet"},
  "hearth.dinner": {"icon":"","label":"Dinner","description":"Pause every kid at once","action":"$HOME/.local/bin/hearth-action run dinner"},
  "hearth.resume": {"icon":"","label":"Resume all","description":"Give everyone their internet back","action":"$HOME/.local/bin/hearth-action run resume"},
  "hearth.kid-ada": {"icon":"","label":"Ada","title":"Ada's internet"},
  "hearth.kid-ada.off": {"icon":"","label":"Internet off","action":"$HOME/.local/bin/hearth-action run off Ada"},
  "hearth.kid-ada.on": {"icon":"","label":"Internet on","action":"$HOME/.local/bin/hearth-action run on Ada"},
  "hearth.kid-ada.game-off": {"icon":"","label":"Kill gaming","action":"$HOME/.local/bin/hearth-action run game off Ada"},
  "hearth.kid-ada.game-on": {"icon":"","label":"Gaming back on","action":"$HOME/.local/bin/hearth-action run game on Ada"},
  "hearth.kid-ada.study-on": {"icon":"","label":"Study mode on","description":"Gaming and video off, schoolwork and audio stay","action":"$HOME/.local/bin/hearth-action run study on Ada"},
  "hearth.kid-ada.study-off": {"icon":"","label":"Study mode off","action":"$HOME/.local/bin/hearth-action run study off Ada"},
  "hearth.kid-ada.bonus-15": {"icon":"","label":"Grant 15 minutes","action":"$HOME/.local/bin/hearth-action run bonus Ada 15 menu"},
  "hearth.kid-ada.bonus-30": {"icon":"","label":"Grant 30 minutes","action":"$HOME/.local/bin/hearth-action run bonus Ada 30 menu"},
  "hearth.kid-ada.time": {"icon":"","label":"How much time is left","action":"$HOME/.local/bin/hearth-action run time Ada"},
  "hearth.kid-ben": {"icon":"","label":"Ben","title":"Ben's internet"},
  "hearth.kid-ben.off": {"icon":"","label":"Internet off","action":"$HOME/.local/bin/hearth-action run off Ben"},
  "hearth.kid-ben.on": {"icon":"","label":"Internet on","action":"$HOME/.local/bin/hearth-action run on Ben"},
  "hearth.kid-ben.game-off": {"icon":"","label":"Kill gaming","action":"$HOME/.local/bin/hearth-action run game off Ben"},
  "hearth.kid-ben.game-on": {"icon":"","label":"Gaming back on","action":"$HOME/.local/bin/hearth-action run game on Ben"},
  "hearth.kid-ben.study-on": {"icon":"","label":"Study mode on","description":"Gaming and video off, schoolwork and audio stay","action":"$HOME/.local/bin/hearth-action run study on Ben"},
  "hearth.kid-ben.study-off": {"icon":"","label":"Study mode off","action":"$HOME/.local/bin/hearth-action run study off Ben"},
  "hearth.kid-ben.bonus-15": {"icon":"","label":"Grant 15 minutes","action":"$HOME/.local/bin/hearth-action run bonus Ben 15 menu"},
  "hearth.kid-ben.bonus-30": {"icon":"","label":"Grant 30 minutes","action":"$HOME/.local/bin/hearth-action run bonus Ben 30 menu"},
  "hearth.kid-ben.time": {"icon":"","label":"How much time is left","action":"$HOME/.local/bin/hearth-action run time Ben"},
  "hearth.kid-cleo": {"icon":"","label":"Cleo","title":"Cleo's internet"},
  "hearth.kid-cleo.off": {"icon":"","label":"Internet off","action":"$HOME/.local/bin/hearth-action run off Cleo"},
  "hearth.kid-cleo.on": {"icon":"","label":"Internet on","action":"$HOME/.local/bin/hearth-action run on Cleo"},
  "hearth.kid-cleo.game-off": {"icon":"","label":"Kill gaming","action":"$HOME/.local/bin/hearth-action run game off Cleo"},
  "hearth.kid-cleo.game-on": {"icon":"","label":"Gaming back on","action":"$HOME/.local/bin/hearth-action run game on Cleo"},
  "hearth.kid-cleo.study-on": {"icon":"","label":"Study mode on","description":"Gaming and video off, schoolwork and audio stay","action":"$HOME/.local/bin/hearth-action run study on Cleo"},
  "hearth.kid-cleo.study-off": {"icon":"","label":"Study mode off","action":"$HOME/.local/bin/hearth-action run study off Cleo"},
  "hearth.kid-cleo.bonus-15": {"icon":"","label":"Grant 15 minutes","action":"$HOME/.local/bin/hearth-action run bonus Cleo 15 menu"},
  "hearth.kid-cleo.bonus-30": {"icon":"","label":"Grant 30 minutes","action":"$HOME/.local/bin/hearth-action run bonus Cleo 30 menu"},
  "hearth.kid-cleo.time": {"icon":"","label":"How much time is left","action":"$HOME/.local/bin/hearth-action run time Cleo"},
  "hearth.status": {"icon":"","label":"What is happening now","action":"$HOME/.local/bin/hearth-action status"},
  "hearth.dashboard": {"icon":"","label":"Open dashboard","action":"$HOME/.local/bin/hearth-action dashboard"},
  "hearth.refresh": {"icon":"","label":"Refresh the kid list","description":"Rebuild these entries from the gateway","action":"$HOME/.local/bin/hearth-action menu"},
  // <<< hearth <<<
}
