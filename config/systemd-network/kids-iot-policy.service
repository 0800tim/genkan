[Unit]
Description=Hearth household IoT policy (learn vendor addresses, reapply the policy)
After=docker.service
[Service]
Type=oneshot
EnvironmentFile=/srv/projects/internal/kids-network/secrets.env
# learn refreshes the vendor address lists and then applies. In observe mode
# (the default) applying changes nothing a device can feel: it only loads the
# counters that show what enforcement would refuse.
ExecStart=/usr/local/bin/kidnet-iot-policy learn
