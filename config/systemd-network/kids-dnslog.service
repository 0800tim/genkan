[Unit]
Description=Genkan DNS log ingest (AdGuard querylog -> dns_log)
After=docker.service
[Service]
Type=oneshot
EnvironmentFile=/srv/projects/internal/kids-network/secrets.env
ExecStart=/usr/local/bin/genkan-dnslog
# Raise alerts on anything flagged in the rows just ingested.
ExecStartPost=-/usr/local/bin/genkan-alerts
