[Unit]
Description=Genkan nightly AI note per child (only if the household turned it on)
After=docker.service
[Service]
Type=oneshot
# Carries KIDS_DB_URL and, if the household set one, GENKAN_AI_SUMMARY_KEY.
# Without the key the worker prints one line and exits 0.
EnvironmentFile=/srv/projects/internal/kids-network/secrets.env
ExecStart=/usr/local/bin/genkan-kid-summary
