[Unit]
Description=Genkan Tor relay list refresh (public relays -> the nft tor_nodes set)
Documentation=file:///srv/projects/internal/kids-network/docs/tor-and-safety.md
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# ONE step. This unit fetches the relay list and puts the addresses in
# Postgres; the gateway rebuilds @tor_nodes from there at startup and hourly,
# the same way it rebuilds every other set it enforces.
#
# There used to be a second step here that piped the rendered nft snippet into
# the gateway container, guarded by "skip if the gateway has no tor_nodes set
# yet, because the running image may predate it". That guard was a fail-open
# that reported success, and it never once applied anything: deploy.sh runs
# this unit immediately after recreating the gateway, which is precisely the
# two minutes the gateway spends in its segment-guard wait with no firewall
# loaded, so the guard was guaranteed to fire and the unit was guaranteed to
# finish green. Three runs, three skips, zero applies, and each one logged
# "Finished kids-tor-sync.service".
#
# It is gone rather than fixed. A second writer for one set, racing the
# gateway's own reconcile and depending on a readiness check being right, is
# worth nothing next to the database the gateway already reads. See
# DECISIONS.md, "A list nobody applies is not a blocklist".
ExecStart=/usr/local/bin/genkan-tor-sync sync
