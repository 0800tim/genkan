#!/usr/sbin/nft -f
# Kids/guest island firewall. Runs INSIDE the gateway container's own network
# namespace, which holds exactly two interfaces: kids0 (the physical USB NIC,
# handed in by kids-nic-warden on the host) and eth0 (a normal Docker bridge
# uplink). Rules here cannot touch the host's firewall, main LAN or tailnet:
# those interfaces do not exist in this namespace.
# Segment: 192.168.60.0/24 on kids0.
#
# Guarantees:
#  - island reaches the INTERNET (via NAT) ................ allowed
#  - island reaches the MAIN LAN / tailnet / internals .... BLOCKED (isolation)
#  - island reaches the Hearth box itself: DHCP, DNS, portal ..... allowed, rest dropped
#  - a device in kids_block set ........................... no internet, BUT it
#    keeps DHCP + DNS + the captive portal, and keeps @kids_allow (help lines),
#    so "off" means "explained and still safe", never "device falls off the net"
#  - all DNS is forced through the Hearth box (no DoH/DoT bypass)
#
# Validate before installing:  nft -c -f config/nftables/kids.nft
# Loaded at boot via /etc/nftables.conf include of /etc/nftables.d/.

define KIDS_IF     = "kids0"
define KIDS_NET    = 192.168.60.0/24
define KIDS_GW     = 192.168.60.1
define PORTAL_PORT = 80
define SPEEDTEST_PORT = 8877
# Everything the island must NOT be able to reach: ALL private space (which
# includes the main house LAN and the Docker networks behind eth0) plus the
# 100.64/10 CGNAT range, which is where Tailscale lives. Isolation is belt AND
# braces: the namespace already hides the host's interfaces, and these rules
# stop the island routing anywhere internal through our own uplink.
define PRIVATE     = { 192.168.0.0/16, 172.16.0.0/12, 10.0.0.0/8, 100.64.0.0/10 }

table inet kids {
    # Devices with their internet cut (kidnet off / out of time / bedtime).
    set kids_block { type ipv4_addr; }

    # Island sources we recognise: the current per-device reservations, synced
    # from the database by the gateway. A device using any OTHER island address
    # is unknown and gets no internet (only the portal). This is what closes
    # the static-IP dodge: picking a different address does not escape control,
    # it just makes you a stranger the gateway will not route for.
    set kids_known { type ipv4_addr; }

    # Devices with a lease that belong to nobody. A lease alone used to be
    # enough to pass @kids_known, so an unclaimed device got FULL unfiltered,
    # unmetered internet, and a rotating phone MAC became an accidental bypass.
    # These get DNS, the portal and the safety net, and nothing else, until
    # somebody says whose they are. Filled only when claim mode is 'enforce'
    # (docs/DEVICE-IDENTITY.md); empty otherwise, so this rule costs nothing.
    set kids_unclaimed { type ipv4_addr; counter; }

    # Destinations that survive a cut: the NZ youth help lines and the
    # education allowlist, resolved from the always_allow table.
    # Populated by `kidnet allow-sync` (deploy + hourly timer), NOT by hand.
    set kids_allow { type ipv4_addr; }

    # Per-category destination IP sets, filled from category_ips (learned from
    # DNS answers). The counters below measure bytes each category pulls, so
    # the meter can tell active use from idle.
    #
    # download is content delivery: a game update, an OS update, an app
    # install. It is counted and charted like the others but never charged to
    # a child's budget, because bandwidth is not screen time. Keeping it as a
    # separate destination set is what stops a 60 GB console update from
    # eating an afternoon of gaming time. See METERING.md.
    set gaming_ips   { type ipv4_addr; flags interval; }
    set video_ips    { type ipv4_addr; flags interval; }
    set download_ips { type ipv4_addr; flags interval; }

    # Per-device byte counters, auto-populated: each island source that talks
    # to a category gets its own counter element. The meter reads these by
    # device IP to attribute active minutes to the right child.
    set gaming_dev   { type ipv4_addr; flags dynamic; counter; }
    set video_dev    { type ipv4_addr; flags dynamic; counter; }
    set download_dev { type ipv4_addr; flags dynamic; counter; }

    # Public Tor relay addresses. Populated by bin/kidnet-tor-sync (deploy plus
    # the daily kids-tor-sync.timer), which renders /var/lib/hearth/tor-nodes.nft
    # and has it applied inside this namespace. NEVER edited by hand: the whole
    # set is flushed and refilled in one transaction. flags interval so address
    # ranges can be added later without a redesign.
    set tor_nodes { type ipv4_addr; flags interval; }

    # Per-device Tor attempt counters, the same pattern as gaming_dev: any
    # island source that touches a known relay gets an element with a counter.
    # The alert pass reads these to attribute an attempt to a child and raise
    # the "worth a quiet word" alert even when DNS saw nothing at all, which is
    # exactly the case of a Tor client with relay addresses baked in.
    set tor_dev { type ipv4_addr; flags dynamic; counter; }

    # Public DoH resolvers. Plain :53 is already redirected to us, so this is
    # the :443 escape hatch. Covers the easy 90%, not a determined bypass.
    set doh_block {
        type ipv4_addr
        elements = {
            1.1.1.1, 1.0.0.1,                  # Cloudflare
            8.8.8.8, 8.8.4.4,                  # Google
            9.9.9.9, 149.112.112.112,          # Quad9
            208.67.222.222, 208.67.220.220,    # OpenDNS
            94.140.14.14, 94.140.15.15,        # AdGuard public
            76.76.2.0, 76.76.10.0              # ControlD
        }
    }

    chain input {                      # traffic FROM the island TO the Hearth box itself
        type filter hook input priority filter; policy accept;
        iifname != $KIDS_IF accept                        # only police the island here
        ct state established,related accept

        # These four must work even for a BLOCKED device. A kid who is "off"
        # still needs an address, still needs DNS (so our resolver can hand
        # them the portal IP and the help lines), and still needs to reach the
        # portal page that explains why. Blocking these is how you turn "no
        # internet" into "the wifi is broken", which teaches nothing.
        iifname $KIDS_IF udp dport { 67, 68 } accept       # DHCP (broadcast, so no daddr)
        # Pinned to the gateway address on purpose. Without the daddr match these
        # would accept the same ports on EVERY address the Hearth box holds, so a kid
        # could reach its main-LAN and tailnet addresses on :80 and :53.
        iifname $KIDS_IF ip daddr $KIDS_GW udp dport 53 accept              # DNS
        iifname $KIDS_IF ip daddr $KIDS_GW tcp dport 53 accept
        iifname $KIDS_IF ip daddr $KIDS_GW tcp dport $PORTAL_PORT accept    # captive portal
        # The speed test. Deliberately reachable by every device on the island,
        # including guests with no account and no VPN, because "is it my wifi
        # or my internet" is the first question every parent asks. It serves
        # random bytes and reports numbers; it holds no household data.
        iifname $KIDS_IF ip daddr $KIDS_GW tcp dport $SPEEDTEST_PORT accept
        iifname $KIDS_IF ip daddr $KIDS_GW icmp type echo-request accept

        iifname $KIDS_IF drop                              # NOTHING else on the Hearth box (no SSH, no dashboard)
    }

    # Metering ("meter" is reserved, so the chain is "metering"). Priority just
    # after filter; these only count via the dynamic sets, never change a
    # verdict. `update` adds the source IP with a counter and accrues bytes.
    chain metering {
        type filter hook forward priority 10; policy accept;
        iifname $KIDS_IF ip daddr @gaming_ips   update @gaming_dev   { ip saddr }
        iifname $KIDS_IF ip daddr @video_ips    update @video_dev    { ip saddr }
        iifname $KIDS_IF ip daddr @download_ips update @download_dev { ip saddr }
    }

    chain forward {                    # traffic FROM the island THROUGH the Hearth box
        type filter hook forward priority filter; policy accept;

        # Isolation is absolute and comes first: nothing below can grant it away.
        iifname $KIDS_IF ip daddr $PRIVATE drop

        iifname $KIDS_IF tcp dport 853 reject              # kill DNS-over-TLS
        iifname $KIDS_IF ip daddr @doh_block tcp dport 443 reject with tcp reset  # kill known DoH

        # The island is IPv4-only. Drop any forwarded IPv6 outright so a future
        # v6-capable uplink or a rogue router advertisement cannot silently
        # sail past every rule below (all of which match on ip, not ip6).
        iifname $KIDS_IF meta nfproto ipv6 drop

        # The safety net. Sits ABOVE the block rules on purpose: 1737, Youthline
        # and the rest stay reachable when a kid is cut off, at bedtime, and
        # when they are out of time, and even for a not-yet-known device. Honest
        # limit: allows by IP, so a help line on a shared CDN address lets those
        # through too.
        iifname $KIDS_IF ip daddr @kids_allow accept

        # Unknown device: not a current reservation, so no internet. Closes the
        # static-IP bypass. Its :80 is sent to the portal (see nat) so the kid
        # sees "this device needs adding", not a dead connection.
        iifname $KIDS_IF ip saddr != @kids_known drop

        # An unclaimed device. BELOW the @kids_allow safety net above, so a
        # help line still answers for a device nobody has named yet, which is
        # the whole point of the safety net. Its :80 goes to the portal (see
        # nat), so the kid sees a page asking who they are rather than a dead
        # connection, and DNS is an input rule so it keeps resolving.
        iifname $KIDS_IF ip saddr @kids_unclaimed drop

        # Tor and the darknet. Deliberately BELOW the @kids_allow safety net,
        # so a help line that happens to share a CDN address with a relay stays
        # reachable, and ABOVE the kids_block rules, so an attempt from an
        # already-blocked device is still counted and still fails fast.
        #
        # Count the attempt first: this rule never changes a verdict, it only
        # records which child reached for a relay, which is the signal a parent
        # actually wants. Then refuse it.
        iifname $KIDS_IF ip daddr @tor_nodes update @tor_dev { ip saddr }
        # Reject, not drop: Tor Browser fails fast instead of hanging, so the
        # kid sees a clear refusal rather than a broken-wifi mystery. The warm
        # "come find me" page arrives by the other two roads: the DNS layer
        # redirects the Tor on-ramps to the portal, and the portal surfaces the
        # tor_dev attempt on its next load. Tor's own TLS to a relay cannot be
        # redirected to an HTTP portal, and pretending otherwise would just
        # produce a certificate error. See docs/tor-and-safety.md.
        iifname $KIDS_IF ip daddr @tor_nodes meta l4proto tcp reject with tcp reset
        iifname $KIDS_IF ip daddr @tor_nodes reject

        # Blocked device: reject :443 with a reset so the browser fails fast and
        # the kid sees the portal, rather than hanging on a black hole for 30s.
        iifname $KIDS_IF ip saddr @kids_block tcp dport 443 reject with tcp reset
        iifname $KIDS_IF ip saddr @kids_block drop
        # No matching rule on daddr. Return traffic reaches this chain AFTER
        # conntrack has reversed the NAT, so its destination is the kid's own
        # address: a daddr @kids_block drop here silently kills the replies for
        # the @kids_allow flows above, taking the safety net with it. Unsolicited
        # inbound cannot reach the island through NAT regardless.

        # anything else from the island = internet, falls through to accept
    }

    # ---- NAT ----------------------------------------------------------------
    chain prerouting {
        type nat hook prerouting priority dstnat; policy accept;
        # Force all plain DNS to the Hearth box's resolver even if a device hardcodes 8.8.8.8.
        iifname $KIDS_IF meta l4proto { tcp, udp } th dport 53 dnat ip to $KIDS_GW
        # Isolation wins over the portal: traffic aimed at the main LAN must be
        # dropped by the forward chain, not quietly answered by the portal.
        iifname $KIDS_IF ip daddr $PRIVATE accept
        # Help lines are never redirected to the portal.
        iifname $KIDS_IF ip daddr @kids_allow accept
        # A blocked OR unknown device's plain HTTP goes to the captive portal,
        # so the OS captive-portal probe fails and the "sign in" sheet pops.
        # Allowed known devices never match, so their probes get the real 204.
        iifname $KIDS_IF ip saddr @kids_block tcp dport 80 redirect to :$PORTAL_PORT
        iifname $KIDS_IF ip saddr != @kids_known tcp dport 80 redirect to :$PORTAL_PORT
        # An unclaimed device HAS a lease, so it is in @kids_known and the rule
        # above never fires for it. Without this line the forward chain drops
        # its traffic and the kid gets a dead connection instead of the page
        # asking who they are, which would make the whole feature useless.
        iifname $KIDS_IF ip saddr @kids_unclaimed tcp dport 80 redirect to :$PORTAL_PORT
    }

    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        # Masquerade island traffic out of ANY non-island interface. In the
        # container that is eth0 (whatever Docker names it); naming no
        # interface keeps this file identical across homes and test rigs.
        ip saddr $KIDS_NET oifname != $KIDS_IF masquerade
    }
}
