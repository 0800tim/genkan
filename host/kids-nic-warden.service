# Installed to /etc/systemd/system/ by deploy.sh. The single host-side piece
# of Hearth: hands the kids' USB NIC into the gateway container and re-does
# it after USB replugs, container restarts and Docker daemon restarts.
[Unit]
Description=Hearth kids-NIC warden (hands the USB NIC to the gateway container)
After=docker.service
Wants=docker.service

[Service]
ExecStart=/usr/local/lib/hearth/kids-nic-warden.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
